  }
}

class _SharedMoreDetails extends StatelessWidget {
  const _SharedMoreDetails({required this.commitment, required this.color});

  final _SharedCommitment commitment;
  final Color color;

  @override
  Widget build(BuildContext context) {
    return _SharedUnifiedCard(
      title: 'إعدادات إضافية',
      icon: Icons.grid_view_rounded,
      color: color,
      children: [
        _SharedInfoRow(
          label: 'المحفظة',
          value: commitment.hasWallet ? 'تم إنشاؤها' : 'غير مفعلة',
          icon: Icons.wallet_outlined,
          color: color,
        ),
        _SharedInfoRow(
          label: 'أول دفعة',
          value: '${commitment.firstPayment} ${commitment.currency}',
          icon: Icons.add_card_rounded,
          color: color,
        ),
        _SharedInfoRow(
          label: 'آخر تحديث',
          value: commitment.lastUpdate,
          icon: Icons.update_rounded,
          color: color,
        ),
      ],
    );
  }
}

class _SearchBar extends StatelessWidget {
  const _SearchBar({
    required this.controller,
    required this.hint,
    required this.onFilterTap,
    required this.onChanged,
  });

  final TextEditingController controller;
  final String hint;
  final VoidCallback onFilterTap;
  final ValueChanged<String> onChanged;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFFE2E8F0)),
      ),
      child: TextField(
        controller: controller,
        textDirection: TextDirection.rtl,
        onChanged: onChanged,
        decoration: InputDecoration(
          hintText: hint,
          hintStyle: const TextStyle(color: Color(0xFF94A3B8), fontSize: 13),
          border: InputBorder.none,
          suffixIcon: const Icon(
            Icons.search_rounded,
            color: Color(0xFF64748B),
          ),
          prefixIcon: IconButton(
            onPressed: onFilterTap,
            icon: const Icon(Icons.tune_rounded, color: Color(0xFF475569)),
            tooltip: 'فلتر',
          ),
          contentPadding: const EdgeInsets.symmetric(
            horizontal: 12,
            vertical: 12,
          ),
        ),
      ),
    );
  }
}

