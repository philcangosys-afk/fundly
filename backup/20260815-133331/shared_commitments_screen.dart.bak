  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  List<_SharedCommitment> _filteredCommitments() {
    final query = _searchController.text.trim();
    final typeKey = _typeFilters[_selectedTypeIndex].$2;

    final filtered = _commitments.where((item) {
      final typeMatches = typeKey == 'all' || item.type == typeKey;
      final queryMatches =
          query.isEmpty ||
          item.title.contains(query) ||
          item.note.contains(query) ||
          item.type.contains(query);
      return typeMatches && queryMatches;
    }).toList();

    if (_selectedSort == 'الأعلى مبلغاً') {
      filtered.sort((a, b) => b.budget.compareTo(a.budget));
    } else if (_selectedSort == 'الأكثر أعضاء') {
      filtered.sort((a, b) => b.membersCount.compareTo(a.membersCount));
    } else {
      filtered.sort((a, b) => b.lastUpdate.compareTo(a.lastUpdate));
    }
    return filtered;
  }

  int _countByType(String key) => key == 'all'
      ? _commitments.length
      : _commitments.where((item) => item.type == key).length;

  IconData _typeFilterIcon(String key) {
    if (key == 'رحلات') return Icons.route_rounded;
    if (key == 'سفر') return Icons.flight_takeoff_rounded;
    if (key == 'جمعيات مالية') return Icons.savings_outlined;
    if (key == 'تجمعات') return Icons.groups_2_outlined;
    if (key == 'اللقاءات') return Icons.forum_outlined;
    return Icons.grid_view_rounded;
  }

  IconData _sharedTypeIcon(String type) {
    if (type == 'رحلات') return Icons.route_rounded;
    if (type == 'سفر') return Icons.flight_takeoff_rounded;
    if (type == 'جمعيات مالية') return Icons.savings_outlined;
    if (type == 'تجمعات') return Icons.groups_2_outlined;
    if (type == 'اللقاءات') return Icons.forum_outlined;
    return Icons.groups_2_outlined;
  }

