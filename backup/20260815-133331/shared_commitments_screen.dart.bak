                            color: group.$3.withValues(alpha: 0.1),
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(
                              color: group.$3.withValues(alpha: 0.3),
                            ),
                          ),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.end,
                            children: [
                              Icon(group.$2, color: group.$3, size: 20),
                              const SizedBox(height: 8),
                              Text(
                                group.$1,
                                textAlign: TextAlign.right,
