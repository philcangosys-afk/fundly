  void _openSharedCommitmentForm(_SharedCommitmentTemplate template) {
    final formKey = GlobalKey<FormState>();
    final controllers = {
      for (final field in template.fields) field.label: TextEditingController(),
    };

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) {
        Future<void> selectDate(TextEditingController controller) async {
          final now = DateTime.now();
          final selected = await showDatePicker(
            context: sheetContext,
            initialDate: now,
            firstDate: DateTime(now.year - 5),
            lastDate: DateTime(now.year + 15),
          );
          if (selected != null) {
            controller.text =
                '${selected.day}/${selected.month}/${selected.year}';
          }
        }

        return SafeArea(
          top: false,
          child: Container(
            constraints: BoxConstraints(
              maxHeight: MediaQuery.of(sheetContext).size.height * 0.92,
            ),
            padding: EdgeInsets.fromLTRB(
              16,
              12,
              16,
              MediaQuery.of(sheetContext).viewInsets.bottom + 16,
            ),
            decoration: const BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
            ),
            child: Directionality(
              textDirection: TextDirection.rtl,
              child: Form(
                key: formKey,
                child: SingleChildScrollView(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Center(
                        child: Container(
                          width: 44,
                          height: 5,
                          decoration: BoxDecoration(
                            color: const Color(0xFFE2E8F0),
                            borderRadius: BorderRadius.circular(99),
                          ),
                        ),
                      ),
                      const SizedBox(height: 16),
                      Row(
                        children: [
                          Container(
                            width: 48,
                            height: 48,
                            decoration: BoxDecoration(
                              color: template.color.withValues(alpha: 0.12),
                              borderRadius: BorderRadius.circular(13),
                            ),
                            child: Icon(
                              template.icon,
                              color: template.color,
                              size: 26,
                            ),
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'إضافة ${template.label}',
                                  style: const TextStyle(
                                    fontSize: 20,
                                    fontWeight: FontWeight.w900,
                                    color: Color(0xFF0F172A),
                                  ),
                                ),
                                Text(
                                  template.subtitle,
                                  style: const TextStyle(
                                    fontSize: 12,
                                    color: Color(0xFF64748B),
                                    fontWeight: FontWeight.w600,
                                  ),
                                ),
                              ],
                            ),
                          ),
                          IconButton(
                            tooltip: 'إغلاق',
                            onPressed: () => Navigator.pop(sheetContext),
                            icon: const Icon(Icons.close_rounded),
                          ),
                        ],
                      ),
                      const SizedBox(height: 18),
                      const Text(
                        'بيانات الالتزام',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w900,
                          color: Color(0xFF1E293B),
                        ),
                      ),
                      const SizedBox(height: 12),
                      for (final field in template.fields) ...[
                        if (field.options.isNotEmpty)
                          DropdownButtonFormField<String>(
                            isExpanded: true,
                            decoration: _createDecoration(
                              field.label,
                              field.icon,
                            ),
                            items: field.options
                                .map(
                                  (option) => DropdownMenuItem(
                                    value: option,
                                    child: Text(option),
                                  ),
                                )
                                .toList(),
                            onChanged: (value) =>
                                controllers[field.label]!.text = value ?? '',
                            validator: (value) {
                              if (field.required &&
                                  (value == null || value.trim().isEmpty)) {
                                return 'يرجى اختيار ${field.label}';
                              }
                              return null;
                            },
                          )
                        else
                          _createField(
                            controllers[field.label]!,
                            field.label,
                            field.icon,
                            required: field.required,
                            numeric: field.numeric,
                            maxLines: field.multiline ? 3 : 1,
                            readOnly: field.date,
                            onTap: field.date
                                ? () => selectDate(controllers[field.label]!)
                                : null,
                          ),
                        const SizedBox(height: 12),
                      ],
                      ElevatedButton.icon(
                        onPressed: () {
                          if (!(formKey.currentState?.validate() ?? false)) {
                            return;
                          }
                          final values = {
                            for (final entry in controllers.entries)
                              if (entry.value.text.trim().isNotEmpty)
                                entry.key: entry.value.text.trim(),
                          };
                          final memberNames = (values['الأعضاء'] ?? '')
                              .split(RegExp(r'[,،]'))
                              .map((name) => name.trim())
                              .where((name) => name.isNotEmpty)
                              .toList();
                          final owner = values['المسؤول'] ?? '';
                          final subscription =
                              int.tryParse(values['قيمة الاشتراك'] ?? '') ?? 0;
                          final months =
                              int.tryParse(values['عدد الشهور'] ?? '') ?? 0;
                          final estimatedBudget = int.tryParse(
                            (values['الميزانية التقديرية'] ?? '').replaceAll(
                              ',',
                              '',
                            ),
                          );
                          final budget =
                              estimatedBudget ??
                              (subscription > 0
                                  ? subscription * (months > 0 ? months : 1)
                                  : 0);
                          final startDate =
                              values['تاريخ البداية'] ??
                              values['تاريخ الانطلاق'] ??
                              values['تاريخ السفر'] ??
                              values['موعد التجمع'] ??
                              values['تاريخ اللقاء'] ??
                              '';
                          final endDate =
                              values['تاريخ النهاية'] ??
                              values['تاريخ العودة'] ??
                              startDate;
                          setState(() {
                            _commitments.insert(
                              0,
                              _SharedCommitment(
                                title: values['اسم الالتزام']!,
                                type: template.label,
                                membersCount: memberNames.length + 1,
                                statusKey: 'active',
                                statusLabel: 'جاري',
                                statusColor: const Color(0xFF10B981),
                                youPay: 0,
                                youGet: 0,
                                progress: 0,
                                note:
                                    values['ملاحظات'] ??
                                    'تم إنشاء التزام ${template.label}',
                                budget: budget,
                                remaining: budget,
                                lastUpdate: 'اليوم',
                                participants: [
                                  _Participant(
                                    name: owner,
                                    role: 'مسؤول',
                                    paid: 0,
                                    due: 0,
                                  ),
                                  ...memberNames
                                      .where((name) => name != owner)
                                      .map(
                                        (name) => _Participant(
                                          name: name,
                                          role: 'عضو',
                                          paid: 0,
                                          due: 0,
                                        ),
                                      ),
                                ],
                                description: values['ملاحظات'] ?? '',
                                startDate: startDate,
                                endDate: endDate,
                                currency:
                                    values['العملة (اختياري)'] ?? 'غير محدد',
                                owner: owner,
                                iconColor: template.color,
                                details: values,
                              ),
                            );
                          });
                          Navigator.pop(sheetContext);
                        },
                        icon: const Icon(Icons.save_outlined),
                        label: Text(
                          'حفظ ${template.label}',
                          style: const TextStyle(fontWeight: FontWeight.w900),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: template.color,
                          foregroundColor: Colors.white,
                          minimumSize: const Size.fromHeight(52),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(13),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
        );
      },
    ).whenComplete(() async {
      await Future<void>.delayed(const Duration(milliseconds: 350));
      for (final controller in controllers.values) {
        controller.dispose();
      }
    });
  }

  void _openLegacyCreateCommitmentSheet() {
    final formKey = GlobalKey<FormState>();
    final nameController = TextEditingController();
    final typeController = TextEditingController();
    final descriptionController = TextEditingController();
    final startDateController = TextEditingController();
    final endDateController = TextEditingController();
    final budgetController = TextEditingController();
    final ownerController = TextEditingController();
    final membersController = TextEditingController();
    final firstPaymentController = TextEditingController();
    String status = 'جاري';
    String currency = 'درهم إماراتي';
    String financialSplit = 'بالتساوي';
    Color iconColor = const Color(0xFF0B4A73);
    bool createBudget = false;
    bool createWallet = false;
    bool addFirstPayment = false;
    XFile? coverImage;

    const iconColors = [
      Color(0xFF0B4A73),
      Color(0xFF0D9488),
      Color(0xFF2563EB),
      Color(0xFF7C3AED),
      Color(0xFFDB2777),
      Color(0xFFF59E0B),
    ];

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setModalState) {
            Future<void> selectDate(TextEditingController controller) async {
              final now = DateTime.now();
              final selected = await showDatePicker(
                context: context,
                initialDate: now,
                firstDate: DateTime(now.year - 5),
                lastDate: DateTime(now.year + 15),
              );
              if (selected != null) {
                controller.text =
                    '${selected.day}/${selected.month}/${selected.year}';
              }
            }

            return SafeArea(
              top: false,
              child: Container(
                constraints: BoxConstraints(
                  maxHeight: MediaQuery.of(context).size.height * 0.94,
                ),
                padding: EdgeInsets.fromLTRB(
                  16,
                  12,
                  16,
                  MediaQuery.of(context).viewInsets.bottom + 16,
                ),
                decoration: const BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
                ),
                child: Directionality(
                  textDirection: TextDirection.rtl,
                  child: Form(
                    key: formKey,
                    child: SingleChildScrollView(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          Center(
                            child: Container(
                              width: 44,
                              height: 5,
                              decoration: BoxDecoration(
                                color: const Color(0xFFE2E8F0),
                                borderRadius: BorderRadius.circular(99),
                              ),
                            ),
                          ),
                          const SizedBox(height: 14),
                          Row(
                            children: [
                              Container(
                                width: 46,
                                height: 46,
                                decoration: BoxDecoration(
                                  color: iconColor.withValues(alpha: 0.12),
                                  borderRadius: BorderRadius.circular(8),
                                ),
                                child: Icon(
                                  Icons.groups_rounded,
                                  color: iconColor,
                                ),
                              ),
                              const SizedBox(width: 10),
                              const Expanded(
                                child: Text(
                                  'إضافة التزام مشترك',
                                  style: TextStyle(
                                    fontSize: 20,
                                    fontWeight: FontWeight.w900,
                                    color: Color(0xFF0F172A),
                                  ),
                                ),
                              ),
                              IconButton(
                                tooltip: 'إغلاق',
                                onPressed: () => Navigator.pop(context),
                                icon: const Icon(Icons.close_rounded),
                              ),
                            ],
                          ),
                          const SizedBox(height: 16),
                          _createField(
                            nameController,
                            'اسم الالتزام',
                            Icons.title_rounded,
                            required: true,
                            hint: 'رحلة صلالة، سفر مصر...',
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            typeController,
                            'النوع',
                            Icons.category_outlined,
                            required: true,
                            hint: 'رحلة، منزل...',
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            descriptionController,
                            'الوصف',
                            Icons.notes_rounded,
                            maxLines: 3,
                          ),
                          const SizedBox(height: 10),
                          OutlinedButton.icon(
                            onPressed: () async {
                              final image = await ImagePicker().pickImage(
                                source: ImageSource.gallery,
                                imageQuality: 82,
                              );
                              if (image != null && context.mounted) {
                                setModalState(() => coverImage = image);
                              }
                            },
                            icon: Icon(
                              coverImage == null
                                  ? Icons.add_photo_alternate_outlined
                                  : Icons.check_circle_rounded,
                            ),
                            label: Text(
                              coverImage == null
                                  ? 'إضافة صورة أو غلاف'
                                  : 'تم اختيار الغلاف',
                            ),
                            style: OutlinedButton.styleFrom(
                              minimumSize: const Size.fromHeight(50),
                              foregroundColor: iconColor,
                              side: BorderSide(color: iconColor),
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(8),
                              ),
                            ),
                          ),
                          const SizedBox(height: 12),
                          const Text(
                            'لون الأيقونة',
                            style: TextStyle(fontWeight: FontWeight.w800),
                          ),
                          const SizedBox(height: 8),
                          Wrap(
                            spacing: 10,
                            runSpacing: 8,
                            children: iconColors.map((color) {
                              final selected = color == iconColor;
                              return InkWell(
                                onTap: () =>
                                    setModalState(() => iconColor = color),
                                customBorder: const CircleBorder(),
                                child: Container(
                                  width: 38,
                                  height: 38,
                                  decoration: BoxDecoration(
                                    color: color,
                                    shape: BoxShape.circle,
                                    border: Border.all(
                                      color: selected
                                          ? const Color(0xFF0F172A)
                                          : Colors.transparent,
                                      width: 3,
                                    ),
                                  ),
                                  child: selected
                                      ? const Icon(
                                          Icons.check_rounded,
                                          color: Colors.white,
                                          size: 20,
                                        )
                                      : null,
                                ),
                              );
                            }).toList(),
                          ),
                          const SizedBox(height: 12),
                          DropdownButtonFormField<String>(
                            initialValue: status,
                            decoration: _createDecoration(
                              'الحالة',
                              Icons.flag_outlined,
                            ),
                            items: const ['جاري', 'مكتمل', 'متوقف']
                                .map(
                                  (value) => DropdownMenuItem(
                                    value: value,
                                    child: Text(value),
                                  ),
                                )
                                .toList(),
                            onChanged: (value) =>
                                setModalState(() => status = value ?? status),
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            startDateController,
                            'تاريخ البداية',
                            Icons.event_outlined,
                            required: true,
                            readOnly: true,
                            onTap: () => selectDate(startDateController),
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            endDateController,
                            'تاريخ النهاية (اختياري)',
                            Icons.event_available_outlined,
                            readOnly: true,
                            onTap: () => selectDate(endDateController),
                          ),
                          const SizedBox(height: 10),
                          DropdownButtonFormField<String>(
                            initialValue: currency,
                            decoration: _createDecoration(
                              'العملة',
                              Icons.currency_exchange_rounded,
                            ),
                            items:
                                const [
                                      'درهم إماراتي',
                                      'ريال عماني',
                                      'ريال سعودي',
                                      'جنيه مصري',
                                      'دولار أمريكي',
                                    ]
                                    .map(
                                      (value) => DropdownMenuItem(
                                        value: value,
                                        child: Text(value),
                                      ),
                                    )
                                    .toList(),
                            onChanged: (value) => setModalState(
                              () => currency = value ?? currency,
                            ),
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            ownerController,
                            'المسؤول عن الالتزام',
                            Icons.person_outline_rounded,
                            required: true,
                          ),
                          const SizedBox(height: 10),
                          _createField(
                            membersController,
                            'إضافة أعضاء',
                            Icons.group_add_outlined,
                            hint: 'افصل بين الأسماء بفاصلة',
                          ),
                          const SizedBox(height: 10),
                          _CreateOptionTile(
                            title: 'إنشاء ميزانية',
                            icon: Icons.account_balance_wallet_outlined,
                            value: createBudget,
                            color: iconColor,
                            onChanged: (value) =>
                                setModalState(() => createBudget = value),
                          ),
                          if (createBudget) ...[
                            const SizedBox(height: 8),
                            _createField(
                              budgetController,
                              'قيمة الميزانية',
                              Icons.payments_outlined,
                              numeric: true,
                              required: true,
                            ),
                          ],
                          const SizedBox(height: 8),
                          _CreateOptionTile(
                            title: 'إنشاء محفظة',
                            icon: Icons.wallet_outlined,
                            value: createWallet,
                            color: iconColor,
                            onChanged: (value) =>
                                setModalState(() => createWallet = value),
                          ),
                          const SizedBox(height: 8),
                          _CreateOptionTile(
                            title: 'إضافة أول دفعة',
                            icon: Icons.add_card_rounded,
                            value: addFirstPayment,
                            color: iconColor,
                            onChanged: (value) =>
                                setModalState(() => addFirstPayment = value),
                          ),
                          if (addFirstPayment) ...[
                            const SizedBox(height: 8),
                            _createField(
                              firstPaymentController,
                              'قيمة أول دفعة',
                              Icons.payments_outlined,
                              numeric: true,
                              required: true,
                            ),
                          ],
                          const SizedBox(height: 10),
                          DropdownButtonFormField<String>(
                            initialValue: financialSplit,
                            isExpanded: true,
                            decoration: _createDecoration(
                              'التقسيم المالي',
                              Icons.call_split_rounded,
                            ),
                            items:
                                const [
                                      'بالتساوي',
                                      'بالنسبة',
                                      'بالمبلغ',
                                      'حسب البنود',
                                      'حسب الاستخدام',
                                      'مخصص',
                                    ]
                                    .map(
                                      (value) => DropdownMenuItem(
                                        value: value,
                                        child: Text(value),
                                      ),
                                    )
                                    .toList(),
                            onChanged: (value) => setModalState(
                              () => financialSplit = value ?? financialSplit,
                            ),
                          ),
                          const SizedBox(height: 18),
                          ElevatedButton.icon(
                            onPressed: () {
                              if (!(formKey.currentState?.validate() ??
                                  false)) {
                                return;
                              }
                              final memberNames = membersController.text
                                  .split(RegExp(r'[,،]'))
                                  .map((name) => name.trim())
                                  .where((name) => name.isNotEmpty)
                                  .toList();
                              final budget = createBudget
                                  ? int.tryParse(budgetController.text) ?? 0
                                  : 0;
                              final firstPayment = addFirstPayment
                                  ? int.tryParse(firstPaymentController.text) ??
                                        0
                                  : 0;
                              setState(() {
                                _commitments.insert(
                                  0,
                                  _SharedCommitment(
                                    title: nameController.text.trim(),
                                    type: typeController.text.trim(),
                                    membersCount: memberNames.length + 1,
                                    statusKey: status == 'مكتمل'
                                        ? 'done'
                                        : 'active',
                                    statusLabel: status,
                                    statusColor: status == 'مكتمل'
                                        ? const Color(0xFF3B82F6)
                                        : const Color(0xFF10B981),
                                    youPay: firstPayment,
                                    youGet: 0,
                                    progress: status == 'مكتمل' ? 1 : 0,
                                    note:
                                        descriptionController.text
                                            .trim()
                                            .isEmpty
                                        ? 'تم إنشاء الالتزام المشترك'
                                        : descriptionController.text.trim(),
                                    budget: budget,
                                    remaining: (budget - firstPayment).clamp(
                                      0,
                                      budget,
                                    ),
                                    lastUpdate: 'اليوم',
                                    participants: [
                                      _Participant(
                                        name: ownerController.text.trim(),
                                        role: 'مسؤول',
                                        paid: firstPayment,
                                        due: 0,
                                      ),
                                      ...memberNames.map(
                                        (name) => _Participant(
                                          name: name,
                                          role: 'عضو',
                                          paid: 0,
                                          due: 0,
                                        ),
                                      ),
                                    ],
                                    description: descriptionController.text
                                        .trim(),
                                    startDate: startDateController.text,
                                    endDate: endDateController.text,
                                    currency: currency,
                                    owner: ownerController.text.trim(),
                                    financialSplit: financialSplit,
                                    iconColor: iconColor,
                                    coverPath: coverImage?.path,
                                    hasWallet: createWallet,
                                    firstPayment: firstPayment,
                                  ),
                                );
                              });
                              Navigator.of(context).pop();
                            },
                            icon: const Icon(
                              Icons.check_circle_outline_rounded,
                            ),
                            label: const Text(
                              'إنشاء الالتزام',
                              style: TextStyle(fontWeight: FontWeight.w900),
                            ),
                            style: ElevatedButton.styleFrom(
                              backgroundColor: iconColor,
                              foregroundColor: Colors.white,
                              minimumSize: const Size.fromHeight(52),
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(8),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            );
          },
        );
      },
    ).whenComplete(() async {
      await Future<void>.delayed(const Duration(milliseconds: 350));
      nameController.dispose();
      typeController.dispose();
      descriptionController.dispose();
      startDateController.dispose();
      endDateController.dispose();
      budgetController.dispose();
      ownerController.dispose();
      membersController.dispose();
      firstPaymentController.dispose();
    });
  }

  Widget _createField(
    TextEditingController controller,
    String label,
    IconData icon, {
    String? hint,
    bool numeric = false,
    bool required = false,
    bool readOnly = false,
    int maxLines = 1,
    VoidCallback? onTap,
  }) {
    return TextFormField(
      controller: controller,
      keyboardType: numeric ? TextInputType.number : TextInputType.text,
      readOnly: readOnly,
      maxLines: maxLines,
      onTap: onTap,
      decoration: _createDecoration(label, icon).copyWith(hintText: hint),
      validator: (value) {
        if (required && (value == null || value.trim().isEmpty)) {
          return 'يرجى إدخال $label';
        }
        if (numeric && value != null && value.trim().isNotEmpty) {
          final number = num.tryParse(value.trim());
          if (number == null || number < 0) return 'أدخل رقماً صحيحاً';
        }
        return null;
      },
    );
  }

  InputDecoration _createDecoration(String label, IconData icon) {
    return InputDecoration(
      labelText: label,
      prefixIcon: Icon(icon, color: const Color(0xFF0B4A73)),
      filled: true,
      fillColor: const Color(0xFFF8FAFC),
      border: OutlineInputBorder(borderRadius: BorderRadius.circular(8)),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(8),
        borderSide: const BorderSide(color: Color(0xFFE2E8F0)),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final filtered = _filteredCommitments();
    final selectedTypeKey = _typeFilters[_selectedTypeIndex].$2;
    final selectedCommitments = selectedTypeKey == 'all'
        ? _commitments
        : _commitments.where((item) => item.type == selectedTypeKey).toList();

    return Scaffold(
      backgroundColor: const Color(0xFFF5F8FC),
      floatingActionButton: AddFab(
        screenId: 'shared_commitments',
        onPressed: _openCreateCommitmentSheet,
        label: 'إضافة التزام مشترك',
        backgroundColor: const Color(0xFF0B4A73),
      ),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: CustomScrollView(
          slivers: [
            ManagementDashboardHeader(
              title: 'الالتزامات المشتركة',
              subtitle: 'تنظيم الالتزامات والدفعات بين المشاركين',
              icon: Icons.groups_2_rounded,
              colors: const [Color(0xFF0B4A73), Color(0xFF0C6A8C)],
              onClose: () => Navigator.of(context).pop(),
            ),
            SliverPadding(
              padding: const EdgeInsets.fromLTRB(16, 16, 16, 2),
              sliver: SliverToBoxAdapter(
                child: ManagementSearchBar(
                  controller: _searchController,
                  hint: 'ابحث في جميع الالتزامات المشتركة...',
                  accentColor: const Color(0xFF0C6A8C),
                  onFilterTap: _openQuickFilterSheet,
                  onChanged: (_) => setState(() {}),
                ),
              ),
            ),
            ManagementPinnedControls(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  ManagementFollowUpCenter(
                    subtitle: _selectedTypeIndex == 0
                        ? 'الأهم والأقرب من جميع الالتزامات المشتركة'
                        : 'متابعة ${_typeFilters[_selectedTypeIndex].$1}',
                    accentColor: const Color(0xFF047857),
                    onMore: _openQuickFilterSheet,
                    metrics: [
                      ManagementMetricData(
                        label: 'مشاركات غير مسددة',
                        count: selectedCommitments
                            .where((item) => item.remaining > 0)
                            .length,
                        icon: Icons.payments_outlined,
                        color: const Color(0xFFC73E4D),
                      ),
                      ManagementMetricData(
                        label: 'دفعات متأخرة',
                        count: selectedCommitments
                            .where((item) => item.statusKey == 'late')
                            .length,
                        icon: Icons.error_outline_rounded,
                        color: const Color(0xFFB56A09),
                      ),
                      ManagementMetricData(
                        label: 'التزامات نشطة',
                        count: selectedCommitments
                            .where((item) => item.statusKey == 'active')
                            .length,
                        icon: Icons.groups_2_outlined,
                        color: const Color(0xFF0C6A8C),
                      ),
                      ManagementMetricData(
                        label: 'قريبة الانتهاء',
                        count: selectedCommitments
                            .where((item) => item.statusKey == 'ending_soon')
                            .length,
                        icon: Icons.event_busy_outlined,
                        color: const Color(0xFF7956A8),
                      ),
                    ],
                  ),
                  const SizedBox(height: 14),
                  const Text(
                    'التصنيفات',
                    textAlign: TextAlign.right,
                    style: TextStyle(
                      fontSize: 13,
                      fontWeight: FontWeight.w900,
                      color: Color(0xFF334155),
                    ),
                  ),
                  const SizedBox(height: 8),
                  SizedBox(
                    height: 42,
                    child: ListView.separated(
                      scrollDirection: Axis.horizontal,
                      reverse: false,
                      itemCount: _typeFilters.length,
                      separatorBuilder: (_, __) => const SizedBox(width: 8),
                      itemBuilder: (context, index) {
                        final item = _typeFilters[index];
                        final isSelected = index == _selectedTypeIndex;
                        return ManagementCategoryTab(
                          label: item.$1,
                          count: _countByType(item.$2),
                          icon: _typeFilterIcon(item.$2),
                          color: item.$3,
                          selected: isSelected,
                          onTap: () =>
                              setState(() => _selectedTypeIndex = index),
                        );
                      },
                    ),
                  ),
                ],
              ),
            ),
            SliverPadding(
              padding: const EdgeInsets.fromLTRB(16, 12, 16, 22),
              sliver: SliverList(
                delegate: SliverChildListDelegate([
                  ManagementSortHeader(
                    value: _selectedSort,
                    options: const [
                      'الأحدث أولاً',
                      'الأعلى مبلغاً',
                      'الأكثر أعضاء',
                    ],
                    onSelected: (value) =>
                        setState(() => _selectedSort = value),
                    title: _typeFilters[_selectedTypeIndex].$2 == 'all'
                        ? 'جميع الالتزامات المشتركة'
                        : _typeFilters[_selectedTypeIndex].$1,
                    count: filtered.length,
                    accentColor: const Color(0xFF0C6A8C),
                  ),
                  const SizedBox(height: 10),
                  ...filtered.map((item) {
                    return Padding(
                      padding: const EdgeInsets.only(bottom: 10),
                      child: ManagementCompactCard(
                        title: item.title,
                        category: '${item.type} · ${item.membersCount} أعضاء',
                        date: item.lastUpdate,
                        value: '${item.budget.toStringAsFixed(0)} درهم',
                        status: item.statusLabel,
                        icon: _sharedTypeIcon(item.type),
                        accentColor: const Color(0xFF0C6A8C),
                        statusColor: item.statusColor,
                        onTap: () => _openCommitmentDetails(item),
                      ),
                    );
                  }),
                  if (filtered.isEmpty)
                    const Padding(
                      padding: EdgeInsets.only(top: 30),
                      child: Center(
                        child: Text(
                          'لا توجد نتائج ضمن هذه التصفية',
                          style: TextStyle(color: Color(0xFF64748B)),
                        ),
                      ),
                    ),
                ]),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

