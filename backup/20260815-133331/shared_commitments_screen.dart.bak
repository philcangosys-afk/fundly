}

class _SharedOverviewDetails extends StatelessWidget {
  const _SharedOverviewDetails({required this.commitment, required this.color});

  final _SharedCommitment commitment;
  final Color color;

  @override
  Widget build(BuildContext context) {
    return _SharedUnifiedCard(
      title: 'ملخص الالتزام',
      icon: Icons.bar_chart_rounded,
      color: color,
      children: [
        _SharedInfoRow(
          label: 'الوصف',
          value: commitment.description.isEmpty
              ? commitment.note
              : commitment.description,
          icon: Icons.notes_rounded,
          color: color,
        ),
        _SharedInfoRow(
          label: 'المسؤول',
          value: commitment.owner.isEmpty ? 'غير محدد' : commitment.owner,
          icon: Icons.person_outline_rounded,
          color: color,
        ),
        _SharedInfoRow(
          label: 'تاريخ البداية',
          value: commitment.startDate.isEmpty
              ? 'غير محدد'
              : commitment.startDate,
          icon: Icons.event_outlined,
          color: color,
        ),
        _SharedInfoRow(
          label: 'تاريخ النهاية',
          value: commitment.endDate.isEmpty ? 'غير محدد' : commitment.endDate,
          icon: Icons.event_available_outlined,
          color: color,
        ),
        _SharedInfoRow(
          label: 'العملة',
          value: commitment.currency,
          icon: Icons.currency_exchange_rounded,
          color: color,
        ),
        _SharedInfoRow(
          label: 'التقسيم المالي',
          value: commitment.financialSplit,
          icon: Icons.call_split_rounded,
          color: color,
        ),
        for (final entry in commitment.details.entries)
          if (!const {
            'اسم الالتزام',
            'المسؤول',
            'تاريخ البداية',
            'تاريخ النهاية',
            'العملة (اختياري)',
            'ملاحظات',
          }.contains(entry.key))
            _SharedInfoRow(
              label: entry.key,
              value: entry.value,
              icon: Icons.info_outline_rounded,
              color: color,
            ),
      ],
    );
  }
}

class _SharedLogDetails extends StatelessWidget {
  const _SharedLogDetails({required this.logs, required this.color});

  final List<String> logs;
  final Color color;

  @override
  Widget build(BuildContext context) {
    return _SharedUnifiedCard(
      title: 'سجل الالتزام',
      icon: Icons.schedule_rounded,
      color: color,
      children: [
        if (logs.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(vertical: 18),
            child: Text(
              'لا توجد إدخالات بعد',
              style: TextStyle(color: Color(0xFF64748B)),
            ),
          )
        else
          ...logs.map(
            (log) => _SharedInfoRow(
              label: log,
              value: 'الآن',
              icon: Icons.check_circle_outline_rounded,
              color: color,
            ),
          ),
      ],
    );
  }
}

