class _SharedTypeChoiceCard extends StatelessWidget {
  const _SharedTypeChoiceCard({required this.template, required this.onTap});

  final _SharedCommitmentTemplate template;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(9),
      child: Container(
        constraints: const BoxConstraints(minHeight: 112),
        padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 10),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(9),
          border: Border.all(color: const Color(0xFFDDE2E7)),
        ),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              width: 40,
              height: 40,
              decoration: BoxDecoration(
                color: template.color.withValues(alpha: 0.12),
                borderRadius: BorderRadius.circular(10),
              ),
              child: Icon(template.icon, color: template.color, size: 22),
            ),
            const SizedBox(height: 10),
            Text(
              template.label,
              textAlign: TextAlign.center,
              style: const TextStyle(
                fontSize: 15,
                fontWeight: FontWeight.w900,
                color: Color(0xFF0F172A),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _SharedCommitment {
  _SharedCommitment({
    required this.title,
    required this.type,
    required this.membersCount,
    required this.statusKey,
    required this.statusLabel,
    required this.statusColor,
    required this.youPay,
    required this.youGet,
    required this.progress,
    required this.note,
    required this.budget,
    required this.remaining,
    required this.lastUpdate,
    required this.participants,
    this.description = '',
    this.startDate = '',
    this.endDate = '',
    this.currency = 'درهم إماراتي',
    this.owner = '',
    this.financialSplit = 'بالتساوي',
    this.iconColor = const Color(0xFF0B4A73),
    this.coverPath,
    this.hasWallet = false,
    this.firstPayment = 0,
    this.details = const {},
  });

  final String title;
  final String type;
  final int membersCount;
  final String statusKey;
  final String statusLabel;
  final Color statusColor;
  final int youPay;
  final int youGet;
  final double progress;
  final String note;
  final int budget;
  final int remaining;
  final String lastUpdate;
  final List<_Participant> participants;
  final String description;
  final String startDate;
  final String endDate;
  final String currency;
  final String owner;
  final String financialSplit;
  final Color iconColor;
  final String? coverPath;
  final bool hasWallet;
  final int firstPayment;
  final Map<String, String> details;
}

class _CreateOptionTile extends StatelessWidget {
  const _CreateOptionTile({
    required this.title,
    required this.icon,
    required this.value,
    required this.color,
    required this.onChanged,
  });

  final String title;
  final IconData icon;
  final bool value;
  final Color color;
  final ValueChanged<bool> onChanged;

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFFF8FAFC),
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: const Color(0xFFE2E8F0)),
      ),
      child: SwitchListTile.adaptive(
        value: value,
        onChanged: onChanged,
        activeTrackColor: color,
        secondary: Icon(icon, color: color),
        title: Text(title, style: const TextStyle(fontWeight: FontWeight.w800)),
      ),
    );
  }
}

class _Participant {
  _Participant({
    required this.name,
    required this.role,
    required this.paid,
    required this.due,
  });

  final String name;
  final String role;
  final int paid;
  final int due;
}

class _ActionTemplate {
  const _ActionTemplate(this.title, this.fields);

  final String title;
  final List<_FieldDef> fields;
}

class _FieldDef {
  const _FieldDef(this.label, this.isNumeric);

  final String label;
  final bool isNumeric;
}
