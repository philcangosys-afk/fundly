                              Text(
                                '${group.$4.length} خيارات',
                                style: TextStyle(
                                  fontSize: 11,
                                  color: group.$3,
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  void _openMainEntryItemsSheet(
    (String, IconData, Color, List<_ActionTemplate>) group,
  ) {
    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (context) {
        return SafeArea(
          top: false,
          child: Container(
            height: MediaQuery.of(context).size.height * 0.72,
            decoration: const BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
            ),
            child: Column(
              children: [
                const SizedBox(height: 10),
                Container(
                  width: 44,
                  height: 4,
                  decoration: BoxDecoration(
                    color: const Color(0xFFCBD5E1),
                    borderRadius: BorderRadius.circular(99),
                  ),
                ),
                Padding(
                  padding: const EdgeInsets.fromLTRB(18, 14, 18, 10),
                  child: Align(
                    alignment: Alignment.centerRight,
                    child: Text(
                      group.$1,
                      style: const TextStyle(
                        fontSize: 19,
                        fontWeight: FontWeight.w800,
                        color: Color(0xFF0F172A),
                      ),
                    ),
                  ),
                ),
                Expanded(
                  child: SingleChildScrollView(
                    padding: const EdgeInsets.fromLTRB(16, 0, 16, 18),
                    child: Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      textDirection: TextDirection.rtl,
                      children: group.$4
                          .map((action) {
                            return ActionChip(
                              onPressed: () {
                                Navigator.of(context).pop();
                                _openActionForm(action, group.$3);
                              },
                              label: Text(action.title),
                              backgroundColor: Colors.white,
                              side: BorderSide(
                                color: group.$3.withValues(alpha: 0.35),
                              ),
                              avatar: Icon(
                                Icons.add_circle_outline_rounded,
                                size: 16,
                                color: group.$3,
                              ),
                            );
                          })
                          .toList(growable: false),
                    ),
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  void _openDetailSectionsSheet(List<String> tabs) {
    showModalBottomSheet<void>(
      context: context,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) {
        return SafeArea(
          top: false,
          child: Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 16),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                const Text(
                  'اختيار تبويب',
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF0F172A),
                  ),
                ),
                const SizedBox(height: 10),
                Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  textDirection: TextDirection.rtl,
                  children: List.generate(tabs.length, (index) {
                    final selected = _selectedTab == index;
                    return ChoiceChip(
                      label: Text(tabs[index]),
                      selected: selected,
                      onSelected: (_) {
                        setState(() => _selectedTab = index);
                        Navigator.of(context).pop();
                      },
                    );
                  }),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final c = widget.commitment;
    final color = Color.lerp(c.iconColor, const Color(0xFF073B67), 0.26)!;
    const tabs = [
      (label: 'الملخص', icon: Icons.bar_chart_rounded),
      (label: 'السجل', icon: Icons.schedule_rounded),
      (label: 'الأعضاء', icon: Icons.groups_outlined),
      (label: 'المستندات', icon: Icons.folder_outlined),
      (label: 'المزيد', icon: Icons.grid_view_rounded),
    ];

    return Scaffold(
      backgroundColor: const Color(0xFFF5F7FA),
      floatingActionButtonLocation: FloatingActionButtonLocation.endFloat,
      floatingActionButton: FloatingActionButton(
        key: const ValueKey('add-shared-detail-entry'),
        tooltip: 'إضافة إدخال رئيسي',
        onPressed: _openMainEntryTypesSheet,
        backgroundColor: const Color(0xFFE5B22E),
        foregroundColor: const Color(0xFF3D2E08),
        elevation: 5,
        shape: const CircleBorder(),
        child: const Icon(Icons.add_rounded, size: 29),
      ),
      appBar: AppBar(
        toolbarHeight: 60,
        backgroundColor: Colors.white,
        surfaceTintColor: Colors.transparent,
        foregroundColor: const Color(0xFF172033),
        elevation: 0,
        scrolledUnderElevation: 1,
        centerTitle: true,
        title: const Text(
          'تفاصيل الالتزام المشترك',
          style: TextStyle(
            fontSize: 18,
            fontWeight: FontWeight.w900,
            color: Color(0xFF172033),
          ),
        ),
        leading: IconButton(
          tooltip: 'رجوع',
          onPressed: () => Navigator.pop(context),
          icon: const Icon(Icons.arrow_back_ios_new_rounded, size: 20),
        ),
      ),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: ListView(
          key: const ValueKey('compact-shared-details'),
          padding: const EdgeInsets.fromLTRB(14, 14, 14, 32),
          children: [
            DetailPageHeader(
              title: c.title,
              subtitle: c.type,
              icon: Icons.group_work_rounded,
              color: color,
              status: c.statusLabel,
              statusColor: c.statusColor,
              metrics: [
                DetailHeaderMetric(
                  label: 'الميزانية',
                  value: '${c.budget}',
                  caption: 'درهم',
                  icon: Icons.account_balance_wallet_outlined,
                ),
                DetailHeaderMetric(
                  label: 'المتبقي',
                  value: '${c.remaining}',
                  caption: 'درهم',
                  icon: Icons.payments_outlined,
                ),
                DetailHeaderMetric(
                  label: 'الأعضاء',
                  value: '${c.membersCount}',
                  icon: Icons.groups_outlined,
                ),
              ],
              trailing: IconButton(
                tooltip: 'المزيد',
                onPressed: () => setState(() => _selectedTab = tabs.length - 1),
                icon: const Icon(
                  Icons.more_vert_rounded,
                  size: 23,
                  color: Color(0xFF475569),
                ),
              ),
            ),
            const SizedBox(height: 12),
            DetailPageTabs(
              sections: tabs
                  .map(
                    (tab) => DetailSectionTab(label: tab.label, icon: tab.icon),
                  )
                  .toList(growable: false),
              selectedIndex: _selectedTab,
              color: color,
              onSelected: (index) => setState(() => _selectedTab = index),
            ),
            const SizedBox(height: 12),
            if (_selectedTab == 0)
              _SharedOverviewDetails(commitment: c, color: color)
            else if (_selectedTab == 1)
              _SharedLogDetails(logs: _logs, color: color)
            else if (_selectedTab == 2)
              _SharedMembersDetails(commitment: c, color: color)
            else if (_selectedTab == 3)
              _SharedDocumentsDetails(commitment: c, color: color)
            else
              _SharedMoreDetails(commitment: c, color: color),
            if (_logs.isNotEmpty) ...[
              const SizedBox(height: 10),
              Text(
                'آخر تحديث: ${_logs.first}',
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: Color(0xFF64748B),
                  fontSize: 11,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

class _SharedHeroMetric extends StatelessWidget {
