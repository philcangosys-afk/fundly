}

class AddFab extends StatefulWidget {
  const AddFab({
    super.key,
    required this.screenId,
    required this.onPressed,
    this.label = '+ إضافة',
    this.icon = Icons.add,
    this.backgroundColor = const Color(0xFF0F6AA8),
    this.foregroundColor = Colors.white,
    this.initialOffset = const Offset(0, 0),
  });

  final String screenId;
  final VoidCallback onPressed;
  final String label;
  final IconData icon;
  final Color backgroundColor;
  final Color foregroundColor;
  final Offset initialOffset;

  @override
  State<AddFab> createState() => _AddFabState();
}

class _AddFabState extends State<AddFab> {
  Offset? _offset;

  String get _xKey => 'add_fab_${widget.screenId}_x';
  String get _yKey => 'add_fab_${widget.screenId}_y';

  @override
  void initState() {
    super.initState();
    _restorePosition();
  }

  Future<void> _restorePosition() async {
    final prefs = await SharedPreferences.getInstance();
    final x = prefs.getDouble(_xKey);
    final y = prefs.getDouble(_yKey);
    if (!mounted) return;
    setState(() {
      _offset = (x == null || y == null) ? widget.initialOffset : Offset(x, y);
    });
  }

  Future<void> _savePosition(Offset offset) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setDouble(_xKey, offset.dx);
    await prefs.setDouble(_yKey, offset.dy);
  }

  @override
  Widget build(BuildContext context) {
    if (_offset == null) {
      return FloatingActionButton.extended(
        onPressed: widget.onPressed,
        backgroundColor: widget.backgroundColor,
        foregroundColor: widget.foregroundColor,
        elevation: 7,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        icon: Icon(widget.icon, color: widget.foregroundColor),
        label: Text(
          widget.label,
          style: TextStyle(
            color: widget.foregroundColor,
            fontWeight: FontWeight.w700,
          ),
        ),
      );
    }

    return Transform.translate(
      offset: _offset!,
      child: Draggable(
        feedback: _buildFab(opacity: 0.95),
        childWhenDragging: const SizedBox(width: 1, height: 1),
        onDragEnd: (details) {
          final overlay =
              Overlay.of(context).context.findRenderObject() as RenderBox;
          final local = overlay.globalToLocal(details.offset);
          final next = Offset(local.dx - 80, local.dy - 70);
          setState(() => _offset = next);
          _savePosition(next);
        },
        child: _buildFab(),
      ),
    );
  }

  Widget _buildFab({double opacity = 1}) {
    return Opacity(
      opacity: opacity,
      child: FloatingActionButton.extended(
        onPressed: widget.onPressed,
        backgroundColor: widget.backgroundColor,
        foregroundColor: widget.foregroundColor,
        elevation: 7,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        icon: Icon(widget.icon, color: widget.foregroundColor),
        label: Text(
          widget.label,
          style: TextStyle(
            color: widget.foregroundColor,
            fontWeight: FontWeight.w700,
          ),
        ),
      ),
    );
  }
}

class AddTypeSheet extends StatelessWidget {
  const AddTypeSheet({super.key, required this.groups});

  final Map<String, List<String>> groups;

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      top: false,
      child: Directionality(
        textDirection: TextDirection.rtl,
        child: ListView(
          shrinkWrap: true,
          padding: const EdgeInsets.fromLTRB(16, 12, 16, 20),
          children: groups.entries
              .map(
                (entry) => Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Text(
                      entry.key,
                      style: const TextStyle(
                        fontSize: 14,
                        fontWeight: FontWeight.w900,
                        color: Color(0xFF0F172A),
                      ),
                    ),
                    const SizedBox(height: 8),
                    Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: entry.value
                          .map(
                            (item) => ActionChip(
                              label: Text(item),
                              onPressed: () => Navigator.of(context).pop(item),
                            ),
                          )
                          .toList(growable: false),
                    ),
                    const SizedBox(height: 12),
                  ],
                ),
              )
              .toList(growable: false),
        ),
      ),
    );
  }
}

class DetailScaffold extends StatelessWidget {
  const DetailScaffold({
    super.key,
    required this.header,
    required this.tabs,
    required this.selectedTabIndex,
    required this.onTabSelected,
    required this.accentColor,
    required this.body,
    this.actions,
  });

  final DetailPageHeader header;
  final List<DetailSectionTab> tabs;
  final int selectedTabIndex;
  final ValueChanged<int> onTabSelected;
  final Color accentColor;
  final Widget body;
  final Widget? actions;

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        header,
        const SizedBox(height: 10),
        if (actions != null) ...[actions!, const SizedBox(height: 10)],
        DetailPageTabs(
          sections: tabs,
          selectedIndex: selectedTabIndex,
          color: accentColor,
          onSelected: onTabSelected,
        ),
        const SizedBox(height: 10),
        body,
      ],
    );
  }
}

class ThreeDotMenu extends StatelessWidget {
  const ThreeDotMenu({super.key, required this.onAction});

  final ValueChanged<ThreeDotMenuAction> onAction;

  @override
  Widget build(BuildContext context) {
    return PopupMenuButton<ThreeDotMenuAction>(
      icon: const Icon(Icons.more_vert_rounded),
      onSelected: onAction,
      itemBuilder: (context) => const [
        PopupMenuItem(
          value: ThreeDotMenuAction.edit,
          child: Text('تعديل البيانات'),
        ),
        PopupMenuItem(value: ThreeDotMenuAction.share, child: Text('مشاركة')),
        PopupMenuItem(value: ThreeDotMenuAction.delete, child: Text('حذف')),
        PopupMenuItem(value: ThreeDotMenuAction.freeze, child: Text('تجميد')),
        PopupMenuItem(
          value: ThreeDotMenuAction.pinHome,
          child: Text('تثبيت الصفحة في الصفحة الرئيسية'),
        ),
      ],
    );
  }
}
