import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../detail_page_chrome.dart';
import '../management_dashboard_chrome.dart';

enum ThreeDotMenuAction { edit, share, delete, freeze, pinHome }

class ModuleHeader extends StatelessWidget {
  const ModuleHeader({
    super.key,
    required this.icon,
    required this.title,
    required this.subtitle,
    required this.moduleColors,
    this.onSmartCalendarTap,
    this.onClose,
  });

  final IconData icon;
  final String title;
  final String subtitle;
  final List<Color> moduleColors;
  final VoidCallback? onSmartCalendarTap;
  final VoidCallback? onClose;

  @override
  Widget build(BuildContext context) {
    return ManagementDashboardHeader(
      title: title,
      subtitle: subtitle,
      icon: icon,
      colors: moduleColors,
      onClose: onClose,
    );
  }
}

class SearchAndFilterBar extends StatelessWidget {
  const SearchAndFilterBar({
    super.key,
    required this.controller,
    required this.hintText,
    required this.accentColor,
    required this.onSearch,
    required this.onFilter,
  });

  final TextEditingController controller;
  final String hintText;
  final Color accentColor;
  final ValueChanged<String> onSearch;
  final VoidCallback onFilter;

  @override
  Widget build(BuildContext context) {
    return ManagementSearchBar(
      controller: controller,
      hint: hintText,
      accentColor: accentColor,
      onChanged: onSearch,
      onFilterTap: onFilter,
    );
  }
}

class FollowUpCenter extends StatelessWidget {
  const FollowUpCenter({
    super.key,
    required this.subtitle,
    required this.metrics,
    this.onMore,
    this.selectedMetricIndex,
    this.onMetricSelected,
  });

  final String subtitle;
  final List<ManagementMetricData> metrics;
  final VoidCallback? onMore;
  final int? selectedMetricIndex;
  final ValueChanged<int>? onMetricSelected;

  @override
  Widget build(BuildContext context) {
    final slots = metrics.length >= 3 ? metrics.take(3).toList() : metrics;
    return ManagementFollowUpCenter(
      subtitle: subtitle,
      metrics: slots,
      onMore: onMore,
      selectedMetricIndex: selectedMetricIndex,
      onMetricSelected: onMetricSelected,
    );
  }
}

class CategoryChipItem {
  const CategoryChipItem({
    required this.label,
    required this.count,
    required this.icon,
    required this.color,
    required this.selected,
    required this.onTap,
  });

  final String label;
  final int count;
  final IconData icon;
  final Color color;
  final bool selected;
  final VoidCallback onTap;
}

class CategoryChipsRow extends StatelessWidget {
  const CategoryChipsRow({super.key, required this.items});

  final List<CategoryChipItem> items;

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: 39,
      child: ListView.separated(
        scrollDirection: Axis.horizontal,
        reverse: true,
        itemCount: items.length,
        separatorBuilder: (_, __) => const SizedBox(width: 7),
        itemBuilder: (context, index) {
          final item = items[index];
          return ManagementCategoryTab(
            label: item.label,
            count: item.count,
            icon: item.icon,
            color: item.color,
            selected: item.selected,
            onTap: item.onTap,
          );
        },
      ),
    );
  }
}

class ListHeaderRow extends StatelessWidget {
  const ListHeaderRow({
    super.key,
    required this.count,
    required this.title,
    required this.sortValue,
    required this.sortOptions,
    required this.accentColor,
    required this.onSortChanged,
