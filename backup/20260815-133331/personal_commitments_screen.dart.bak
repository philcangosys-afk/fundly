class _EntryType {
  final String label;
  final IconData icon;

  const _EntryType(this.label, this.icon);
}

enum _FinancialFieldKind { text, number, date, multiline, secret, select }

class _FinancialField {
  final String label;
  final IconData icon;
  final _FinancialFieldKind kind;
  final bool required;
  final bool isPrimary;
  final bool isTitle;
  final bool isAmount;
  final List<String> options;

  const _FinancialField(
    this.label,
    this.icon, {
    this.kind = _FinancialFieldKind.text,
    this.required = false,
    this.isPrimary = false,
    this.isTitle = false,
    this.isAmount = false,
    this.options = const [],
  });
}

class _FinancialEntryForm {
  final String label;
  final String subtitle;
  final IconData icon;
  final Color color;
  final List<_FinancialField> fields;

  const _FinancialEntryForm({
    required this.label,
    required this.subtitle,
    required this.icon,
    required this.color,
    required this.fields,
  });
}

