class _DetailsNavigationBar extends StatelessWidget {
  final List<({String label, IconData icon})> sections;
  final int selectedIndex;
  final Color color;
  final ValueChanged<int> onSelected;

  const _DetailsNavigationBar({
    required this.sections,
    required this.selectedIndex,
    required this.color,
    required this.onSelected,
  });

  @override
  Widget build(BuildContext context) {
    const tabColors = [
      Color(0xFF2860DE),
      Color(0xFF22A181),
      Color(0xFFFF9418),
      Color(0xFF7855E7),
    ];
    return Container(
      height: 88,
      decoration: BoxDecoration(
        color: Colors.white,
        border: Border.all(color: const Color(0xFFEDF1F7)),
        boxShadow: const [
          BoxShadow(
            color: Color(0x180F172A),
            blurRadius: 18,
            offset: Offset(0, 7),
          ),
        ],
      ),
      child: Row(
        textDirection: TextDirection.rtl,
        children: List.generate(sections.length, (index) {
          final section = sections[index];
          final selected = index == selectedIndex;
          final tabColor = tabColors[index % tabColors.length];
          return Expanded(
            child: InkWell(
              onTap: () => onSelected(index),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(section.icon, size: 29, color: tabColor),
                  const SizedBox(height: 7),
                  Text(
                    section.label,
                    style: TextStyle(
                      fontSize: 12,
                      color: selected ? tabColor : const Color(0xFF64748B),
                      fontWeight: selected ? FontWeight.w900 : FontWeight.w600,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Container(
                    width: 42,
                    height: 3,
                    decoration: BoxDecoration(
                      color: selected ? tabColor : Colors.transparent,
                      borderRadius: BorderRadius.circular(99),
                    ),
                  ),
                ],
              ),
            ),
          );
        }),
      ),
    );
  }
}

class _SummaryDetailsCard extends StatelessWidget {
  final _CommitmentItem item;
  final Color color;
  final bool expanded;
  final bool Function(String label) isSensitive;
  final VoidCallback onToggleExpanded;

  const _SummaryDetailsCard({
    required this.item,
    required this.color,
    required this.expanded,
    required this.isSensitive,
    required this.onToggleExpanded,
  });

  @override
  Widget build(BuildContext context) {
    final detailEntries = item.details.entries
        .where(
          (entry) => !const {
            _addedAttachmentTypeKey,
            _addedAttachmentNameKey,
          }.contains(entry.key),
        )
        .toList(growable: false);
    final visibleEntries = expanded
        ? detailEntries
        : detailEntries.take(4).toList(growable: false);

    return _UnifiedDetailsCard(
      title: 'معلومات ${item.entryType ?? 'الالتزام'}',
      icon: Icons.info_rounded,
      color: color,
      children: [
        _UnifiedInfoRow(
          label: 'نوع الالتزام',
          value: item.entryType ?? 'التزام شخصي',
          icon: Icons.category_outlined,
        ),
        _UnifiedInfoRow(
          label: 'الحالة',
          value: item.status,
          icon: Icons.verified_user_outlined,
          valueColor: item.statusColor,
        ),
        _UnifiedInfoRow(
          label: 'تاريخ الاستحقاق',
          value: item.dueDate.isEmpty ? 'غير محدد' : item.dueDate,
          icon: Icons.event_outlined,
        ),
        ...visibleEntries.map(
          (entry) => _UnifiedInfoRow(
            label: entry.key,
            value: isSensitive(entry.key) ? '••••••••' : entry.value,
            icon: Icons.notes_rounded,
          ),
        ),
        _UnifiedInfoRow(
          label: 'المرفق',
          value: item.attachmentPath == null ? 'لا يوجد' : 'مستند مرفق',
          icon: Icons.attach_file_rounded,
        ),
        if (detailEntries.length > 4)
          Padding(
            padding: const EdgeInsets.only(top: 8),
            child: TextButton.icon(
              onPressed: onToggleExpanded,
              iconAlignment: IconAlignment.end,
              icon: Icon(
                expanded
                    ? Icons.keyboard_arrow_up_rounded
                    : Icons.keyboard_arrow_down_rounded,
              ),
              label: Text(expanded ? 'عرض أقل' : 'عرض كل التفاصيل'),
              style: TextButton.styleFrom(
                minimumSize: const Size.fromHeight(42),
                foregroundColor: color,
                backgroundColor: color.withValues(alpha: 0.07),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(8),
                ),
              ),
            ),
          ),
      ],
    );
  }
}

class _HistoryDetailsCard extends StatelessWidget {
  final _CommitmentItem item;
  final Color color;

  const _HistoryDetailsCard({required this.item, required this.color});

  @override
