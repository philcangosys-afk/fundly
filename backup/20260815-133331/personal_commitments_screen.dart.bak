  Future<void> _openDetails(
    _CommitmentItem item, {
    bool openEdit = false,
  }) async {
    final wasDeleted = await Navigator.of(context).push<bool>(
      MaterialPageRoute(
        builder: (_) => _PersonalCommitmentDetailsScreen(
          item: item,
          repository: _repository,
          openEditOnStart: openEdit,
        ),
      ),
    );
    if (!mounted) return;
    if (wasDeleted == true) _items.remove(item);
    setState(() {});
  }

  void _addEntryLike(_CommitmentItem item) {
    final form = item.entryType == null
        ? null
        : _financialEntryForms[item.entryType];
    if (form == null) {
      _openNewEntrySheet();
      return;
    }
    _openFinancialEntryForm(form);
  }

  @override
  Widget build(BuildContext context) {
    final filtered = _filteredItems();

    return Scaffold(
      backgroundColor: const Color(0xFFF8FAFC),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: CustomScrollView(
          slivers: [
            const ManagementDashboardHeader(
              title: 'الالتزامات الشخصية',
              subtitle: 'إدارة ومتابعة كل التزاماتك في مكان واحد',
              icon: Icons.account_balance_wallet_rounded,
              colors: [Color(0xFF1D4ED8), Color(0xFF2563EB)],
            ),
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(12, 8, 12, 2),
                child: _buildSearchControl(),
              ),
            ),
            ManagementPinnedControls(
              horizontalPadding: 12,
              child: _buildPinnedControls(),
            ),
            SliverPadding(
              padding: const EdgeInsets.fromLTRB(12, 12, 12, 80),
              sliver: SliverList(
                delegate: SliverChildListDelegate([
                  _buildListHeader(filtered.length),
                  const SizedBox(height: 10),
                  if (filtered.isEmpty)
                    _buildEmptyState()
                  else
                    ...filtered.map(
                      (item) => Padding(
                        padding: const EdgeInsets.only(bottom: 10),
                        child: _CommitmentCard(
                          item: item,
                          onTap: () => _openDetails(item),
                          onEdit: () => _openDetails(item, openEdit: true),
                          onAdd: () => _addEntryLike(item),
                        ),
                      ),
                    ),
                ]),
              ),
            ),
          ],
        ),
      ),
      floatingActionButton: AddFab(
        screenId: 'personal_commitments',
        onPressed: _openNewEntrySheet,
        label: 'إضافة التزام',
        backgroundColor: const Color(0xFF3B82F6),
      ),
    );
  }

  Widget _buildSearchControl() {
    return Row(
      children: [
        Expanded(
          child: TextField(
            key: const ValueKey('personal-search-field'),
            controller: _searchController,
            textDirection: TextDirection.rtl,
            onChanged: (_) => setState(() {}),
            decoration: InputDecoration(
              hintText: 'ابحث في جميع الالتزامات...',
              hintStyle: const TextStyle(
                color: Color(0xFF94A3B8),
                fontSize: 13,
                fontWeight: FontWeight.w600,
              ),
              suffixIcon: const Icon(
                Icons.search_rounded,
                color: Color(0xFF64748B),
              ),
              filled: true,
              fillColor: Colors.white,
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: const BorderSide(color: Color(0xFFE2E8F0)),
              ),
              enabledBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: const BorderSide(color: Color(0xFFE2E8F0)),
              ),
              focusedBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: const BorderSide(
                  color: Color(0xFF3B82F6),
                  width: 1.4,
                ),
              ),
              contentPadding: const EdgeInsets.symmetric(vertical: 13),
            ),
          ),
        ),
        const SizedBox(width: 9),
        PopupMenuButton<String>(
          key: const ValueKey('personal-filter-button'),
          tooltip: 'تصفية الالتزامات',
          initialValue: _selectedEntryType,
          onSelected: (value) => setState(() => _selectedEntryType = value),
          itemBuilder: (context) => _personalDashboardFilters
              .map(
                (filter) => PopupMenuItem<String>(
                  value: filter.$1,
                  child: Text(filter.$1),
                ),
              )
              .toList(),
          child: Container(
            width: 50,
            height: 50,
            decoration: BoxDecoration(
              color: const Color(0xFF1677FF),
              borderRadius: BorderRadius.circular(14),
              boxShadow: const [
                BoxShadow(
                  color: Color(0x293B82F6),
                  blurRadius: 12,
                  offset: Offset(0, 5),
                ),
              ],
            ),
            child: const Icon(
              Icons.tune_rounded,
              color: Colors.white,
              size: 22,
            ),
          ),
        ),
      ],
    );
  }

  static const _personalDashboardFilters = [
    ('الكل', Icons.grid_view_rounded, Color(0xFF1677FF)),
    ('المصروفات الشخصية', Icons.arrow_downward_rounded, Color(0xFFF04438)),
    ('الدخل', Icons.arrow_upward_rounded, Color(0xFF16A34A)),
    ('الديون', Icons.account_balance_wallet_rounded, Color(0xFFF59E0B)),
    ('الغرامات', Icons.gavel_rounded, Color(0xFFE11D48)),
    ('المستندات', Icons.description_outlined, Color(0xFF0F6AA8)),
    ('الأدوية', Icons.medication_outlined, Color(0xFF0F9F6E)),
    ('التحويلات المالية', Icons.swap_horiz_rounded, Color(0xFF7C3AED)),
    ('الكلمات السرية', Icons.password_rounded, Color(0xFF475569)),
    ('المواقع والأماكن', Icons.location_on_outlined, Color(0xFFD05A3A)),
    ('الاشتراكات', Icons.event_note_rounded, Color(0xFF0EA5A8)),
  ];

  Widget _buildPinnedControls() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _buildFollowUpCenter(),
        const SizedBox(height: 14),
        const Text(
          'التصنيفات',
          textAlign: TextAlign.right,
          style: TextStyle(
            fontSize: 13,
            fontWeight: FontWeight.w900,
            color: Color(0xFF334155),
          ),
        ),
        const SizedBox(height: 8),
        SizedBox(
          height: 42,
          child: ListView.separated(
            key: const ValueKey('personal-category-tabs'),
            scrollDirection: Axis.horizontal,
            reverse: false,
            itemCount: _personalDashboardFilters.length,
            separatorBuilder: (_, __) => const SizedBox(width: 8),
            itemBuilder: (context, index) {
              final filter = _personalDashboardFilters[index];
              final selected = _selectedEntryType == filter.$1;
              return _PersonalCategoryTab(
                label: filter.$1,
                count: _countByEntryType(filter.$1),
                icon: filter.$2,
                color: filter.$3,
                selected: selected,
                onTap: () => setState(() => _selectedEntryType = filter.$1),
              );
            },
          ),
        ),
      ],
    );
  }

  Widget _buildFollowUpCenter() {
    final selectedItems = _itemsForSelectedEntryType();
    final overdue = selectedItems
        .where((item) => item.status == _statusOverdue)
        .length;
    final dueSoon = selectedItems
        .where((item) => item.status == _statusDueSoon)
        .length;
    final documents = selectedItems
        .where(
          (item) =>
              item.entryType == 'مستند' && item.status != _statusCompleted,
        )
        .length;
    final renewals = selectedItems
        .where(
          (item) =>
              item.entryType == 'اشتراكات' && item.status != _statusCompleted,
        )
        .length;
    final reminders = selectedItems
        .where(
          (item) =>
              const {'موعد', 'عادة'}.contains(item.entryType) &&
              item.status != _statusCompleted,
        )
        .length;
    final pendingTasks = selectedItems
        .where(
          (item) => item.entryType == 'مهمة' && item.status != _statusCompleted,
        )
        .length;
    final metrics = [
      (
        'دفعات قادمة',
        dueSoon,
        Icons.payments_outlined,
        const Color(0xFF2563EB),
      ),
      (
        'التزامات متأخرة',
        overdue,
        Icons.error_outline_rounded,
        const Color(0xFFC73E4D),
      ),
      (
        'مستندات قريبة الانتهاء',
        documents,
        Icons.description_outlined,
        const Color(0xFFB56A09),
      ),
      (
        'تجديدات قادمة',
        renewals,
        Icons.autorenew_rounded,
        const Color(0xFF0F6AA8),
      ),
      (
        'تذكيرات نشطة',
        reminders,
        Icons.notifications_active_outlined,
        const Color(0xFF7956A8),
      ),
      (
        'مهام معلقة',
        pendingTasks,
        Icons.task_alt_rounded,
        const Color(0xFF07835C),
      ),
    ];

    return Container(
      key: const ValueKey('personal-follow-up-center'),
      padding: const EdgeInsets.fromLTRB(11, 9, 11, 10),
      decoration: BoxDecoration(
        color: const Color(0xFFFAF7EC),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: const Color(0xFFE8DCB5)),
        boxShadow: const [
          BoxShadow(
            color: Color(0x128A6D1F),
            blurRadius: 18,
            offset: Offset(0, 7),
          ),
        ],
      ),
      child: Column(
        children: [
          Row(
            children: [
              Container(
                width: 36,
                height: 36,
                decoration: BoxDecoration(
                  color: const Color(0xFFE8DCB5),
                  borderRadius: BorderRadius.circular(11),
                ),
                child: const Icon(
                  Icons.dashboard_customize_outlined,
                  color: Color(0xFF8A6D1F),
                  size: 20,
                ),
              ),
              const SizedBox(width: 9),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'مركز المتابعة',
                      style: const TextStyle(
                        fontSize: 14.5,
                        fontWeight: FontWeight.w900,
                        color: Color(0xFF8A6D1F),
                      ),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      _selectedEntryType == 'الكل'
                          ? 'الأهم والأقرب من جميع الالتزامات'
                          : 'متابعة $_selectedEntryType',
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontSize: 10,
                        fontWeight: FontWeight.w600,
                        color: Color(0xFF8A6D1F),
                      ),
                    ),
                  ],
                ),
              ),
              IconButton(
                key: const ValueKey('personal-follow-up-more'),
                onPressed: _openFollowUpSheet,
                tooltip: 'عرض المتابعة كاملة',
                visualDensity: VisualDensity.compact,
                color: const Color(0xFF8A6D1F),
                icon: const Icon(Icons.arrow_forward_ios_rounded, size: 19),
              ),
            ],
          ),
          const SizedBox(height: 7),
          SizedBox(
            height: 56,
            child: ListView.separated(
              scrollDirection: Axis.horizontal,
              reverse: true,
              itemCount: metrics.length,
              separatorBuilder: (_, __) => const SizedBox(width: 7),
              itemBuilder: (context, index) {
                final metric = metrics[index];
                return SizedBox(
                  width: 112,
                  child: _FollowUpMetric(
                    label: metric.$1,
                    count: metric.$2,
                    icon: metric.$3,
                    selected: _selectedFollowUpMetric == index,
                    onTap: () =>
                        setState(() => _selectedFollowUpMetric = index),
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  void _openFollowUpSheet() {
    final followUpItems =
        _itemsForSelectedEntryType()
            .where((item) => item.status != _statusCompleted)
            .toList()
          ..sort((a, b) {
            final aPriority = _statusPriority[a.status] ?? 99;
            final bPriority = _statusPriority[b.status] ?? 99;
            return aPriority.compareTo(bPriority);
          });

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) => Directionality(
        textDirection: TextDirection.rtl,
        child: FractionallySizedBox(
          heightFactor: 0.82,
          child: Container(
            decoration: const BoxDecoration(
              color: Color(0xFFF8FAFC),
              borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
            ),
            child: Column(
              children: [
                Container(
                  width: 44,
                  height: 4,
                  margin: const EdgeInsets.only(top: 10, bottom: 12),
                  decoration: BoxDecoration(
                    color: const Color(0xFFCBD5E1),
                    borderRadius: BorderRadius.circular(4),
                  ),
                ),
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 18),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.dashboard_customize_outlined,
                        color: Color(0xFF2563EB),
                      ),
                      const SizedBox(width: 9),
                      Expanded(
                        child: Text(
                          _selectedEntryType == 'الكل'
                              ? 'قائمة المتابعة الكاملة'
                              : 'متابعة $_selectedEntryType',
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.w900,
                            color: Color(0xFF0F172A),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 12),
                Expanded(
                  child: followUpItems.isEmpty
                      ? const Center(
                          child: Text(
                            'لا توجد عناصر تحتاج إلى متابعة حالياً',
                            style: TextStyle(
                              fontWeight: FontWeight.w700,
                              color: Color(0xFF64748B),
                            ),
                          ),
                        )
                      : ListView.separated(
                          key: const ValueKey('personal-follow-up-list'),
                          padding: const EdgeInsets.fromLTRB(14, 0, 14, 24),
                          itemCount: followUpItems.length,
                          separatorBuilder: (_, __) =>
                              const SizedBox(height: 8),
                          itemBuilder: (context, index) {
                            final item = followUpItems[index];
                            return _FollowUpListItem(
                              item: item,
                              onTap: () {
                                Navigator.of(sheetContext).pop();
                                Future<void>.delayed(
                                  Duration.zero,
                                  () => _openDetails(item),
                                );
                              },
                            );
                          },
                        ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildListHeader(int count) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Row(
          textDirection: TextDirection.rtl,
          children: [
            Container(
              constraints: const BoxConstraints(minWidth: 36),
              height: 36,
              padding: const EdgeInsets.symmetric(horizontal: 9),
              alignment: Alignment.center,
              decoration: BoxDecoration(
                color: const Color(0xFFEAF2FF),
                borderRadius: BorderRadius.circular(11),
              ),
              child: Text(
                '$count',
                style: const TextStyle(
                  fontSize: 14,
                  fontWeight: FontWeight.w900,
                  color: Color(0xFF1677FF),
                ),
              ),
            ),
            const SizedBox(width: 9),
            Expanded(
              child: Text(
                _selectedEntryType == 'الكل'
                    ? 'جميع الالتزامات'
                    : _selectedEntryType,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                style: const TextStyle(
                  fontSize: 14,
                  fontWeight: FontWeight.w900,
                  color: Color(0xFF0F172A),
                ),
              ),
            ),
            PopupMenuButton<String>(
              key: const ValueKey('personal-sort-button'),
              tooltip: 'ترتيب الالتزامات',
              initialValue: _selectedSort,
              onSelected: (value) => setState(() => _selectedSort = value),
              itemBuilder: (context) => const [
                PopupMenuItem(
                  value: 'الأحدث أولاً',
                  child: Text('الأحدث أولاً'),
                ),
                PopupMenuItem(value: 'متأخرة', child: Text('متأخرة')),
                PopupMenuItem(
                  value: 'قريبة الاستحقاق',
                  child: Text('قريبة الاستحقاق'),
                ),
                PopupMenuItem(value: 'مكتملة', child: Text('مكتملة')),
                PopupMenuItem(value: 'نشطة', child: Text('نشطة')),
              ],
              child: Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(
                    _selectedSort,
                    style: const TextStyle(
                      fontSize: 10.5,
                      fontWeight: FontWeight.w800,
                      color: Color(0xFF2563EB),
                    ),
                  ),
                  const SizedBox(width: 2),
                  const Icon(
                    Icons.keyboard_arrow_down_rounded,
                    size: 16,
                    color: Color(0xFF2563EB),
                  ),
                ],
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _buildEmptyState() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 32),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFFE2E8F0)),
      ),
      child: Column(
        children: [
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: const Color(0xFF3B82F6).withOpacity(0.1),
              shape: BoxShape.circle,
            ),
            child: const Icon(
              Icons.inbox_outlined,
              size: 32,
              color: Color(0xFF3B82F6),
            ),
          ),
          const SizedBox(height: 10),
          const Text(
            'لا توجد التزامات مطابقة',
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w800,
              color: Color(0xFF0F172A),
            ),
          ),
          const SizedBox(height: 4),
          const Text(
            'جرّب تغيير الفلتر أو مسح البحث',
            style: TextStyle(
              fontSize: 12,
              color: Color(0xFF64748B),
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }
}

class _PersonalCommitmentDetailsScreen extends StatefulWidget {
  final _CommitmentItem item;
  final PersonalEntriesRepository repository;
  final bool openEditOnStart;

  const _PersonalCommitmentDetailsScreen({
    required this.item,
    required this.repository,
    this.openEditOnStart = false,
  });

  @override
  State<_PersonalCommitmentDetailsScreen> createState() =>
      _PersonalCommitmentDetailsScreenState();
}

class _PersonalCommitmentDetailsScreenState
    extends State<_PersonalCommitmentDetailsScreen> {
  int _detailSectionIndex = 0;
  bool _showAllDetails = false;

  static const _detailSections = [
    (label: 'الملخص', icon: Icons.bar_chart_rounded),
    (label: 'السجل', icon: Icons.schedule_rounded),
    (label: 'المستندات', icon: Icons.folder_outlined),
    (label: 'المتابعة', icon: Icons.notifications_none_rounded),
  ];

  @override
  void initState() {
    super.initState();
    if (widget.openEditOnStart) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted) _openEditForm();
      });
    }
  }

  Color get _pageColor =>
      Color.lerp(widget.item.iconColor, const Color(0xFF073B67), 0.38)!;

  String _detailValue(List<String> labels, {String fallback = 'غير محدد'}) {
    for (final label in labels) {
      final value = widget.item.details[label]?.trim();
      if (value != null && value.isNotEmpty) return value;
    }
    return fallback;
  }

  Future<void> _openAddAttachmentMenu() async {
    final attachmentType = await showModalBottomSheet<String>(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) => Directionality(
        textDirection: TextDirection.rtl,
        child: SafeArea(
          top: false,
          child: Container(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 18),
            decoration: const BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
            ),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Center(
                  child: Container(
                    width: 42,
                    height: 4,
                    decoration: BoxDecoration(
                      color: const Color(0xFFCBD5E1),
                      borderRadius: BorderRadius.circular(99),
                    ),
                  ),
                ),
                const SizedBox(height: 16),
                const Text(
                  'إضافة إلى الالتزام',
                  style: TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.w900,
                    color: Color(0xFF172033),
                  ),
                ),
                const SizedBox(height: 4),
                const Text(
                  'اختر نوع المرفق الذي تريد إضافته',
                  style: TextStyle(
                    fontSize: 11,
                    fontWeight: FontWeight.w600,
                    color: Color(0xFF64748B),
                  ),
                ),
                const SizedBox(height: 14),
                _AttachmentTypeOption(
                  key: const ValueKey('add-invoice-option'),
                  label: 'إضافة فاتورة',
                  caption: 'صورة فاتورة مرتبطة بهذا المصروف',
                  icon: Icons.receipt_long_outlined,
                  color: const Color(0xFFE56B22),
                  onTap: () => Navigator.pop(sheetContext, 'فاتورة'),
                ),
                const SizedBox(height: 9),
                _AttachmentTypeOption(
                  key: const ValueKey('add-document-option'),
                  label: 'إضافة مستند',
                  caption: 'صورة مستند أو إثبات مرتبط بالالتزام',
                  icon: Icons.description_outlined,
                  color: const Color(0xFF087F5B),
                  onTap: () => Navigator.pop(sheetContext, 'مستند'),
                ),
              ],
            ),
          ),
        ),
      ),
    );
    if (attachmentType == null || !mounted) return;

    final attachment = await ImagePicker().pickImage(
      source: ImageSource.gallery,
      imageQuality: 88,
    );
    if (attachment == null || !mounted) return;
    await _saveAddedAttachment(attachmentType, attachment);
  }

  Future<void> _handleMenuAction(_CommitmentMenuAction action) async {
    switch (action) {
      case _CommitmentMenuAction.edit:
        await _openEditForm();
      case _CommitmentMenuAction.share:
        await _shareCommitment();
      case _CommitmentMenuAction.delete:
        await _deleteCommitment();
      case _CommitmentMenuAction.archive:
        await _archiveCommitment();
    }
  }

  Future<void> _shareCommitment() async {
    final item = widget.item;
    final box = context.findRenderObject() as RenderBox?;
    await SharePlus.instance.share(
      ShareParams(
        subject: item.title,
        text: [
          item.title,
          'النوع: ${item.entryType ?? 'التزام شخصي'}',
          'المبلغ: ${item.totalAmount} درهم',
          'الاستحقاق: ${item.dueDate.isEmpty ? 'غير محدد' : item.dueDate}',
          'الحالة: ${item.status}',
        ].join('\n'),
        sharePositionOrigin: box == null
            ? null
            : box.localToGlobal(Offset.zero) & box.size,
      ),
    );
  }

  Future<void> _archiveCommitment() async {
    final item = widget.item;
    try {
      final updated = await widget.repository.update(
        PersonalEntryRecord(
          id: item.id,
          category: item.category,
          entryType: item.entryType ?? '',
          title: item.title,
          amount: item.totalAmount,
          dueDate: item.dueDate,
          status: 'مؤرشف',
          details: item.details,
          attachmentUrl: item.attachmentPath,
        ),
      );
      if (!mounted) return;
      setState(() {
        item.status = updated.status;
        item.statusColor = const Color(0xFF64748B);
        item.lastUpdate = 'الآن';
      });
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('تمت أرشفة الالتزام')));
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('تعذر أرشفة الالتزام. حاول مرة أخرى.')),
      );
    }
  }

  Future<void> _deleteCommitment() async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => Directionality(
        textDirection: TextDirection.rtl,
        child: AlertDialog(
          title: const Text('حذف الالتزام'),
          content: Text(
            'هل تريد حذف «${widget.item.title}» نهائيًا؟ لا يمكن التراجع عن هذا الإجراء.',
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext, false),
              child: const Text('إلغاء'),
            ),
            FilledButton(
              onPressed: () => Navigator.pop(dialogContext, true),
              style: FilledButton.styleFrom(
                backgroundColor: const Color(0xFFB42318),
              ),
              child: const Text('حذف'),
            ),
          ],
        ),
      ),
    );
    if (confirmed != true || !mounted) return;
    final id = widget.item.id;
    if (id == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('تعذر حذف الالتزام غير المحفوظ.')),
      );
      return;
    }
    try {
      await widget.repository.delete(id);
      if (!mounted) return;
      Navigator.pop(context, true);
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('تعذر حذف الالتزام. حاول مرة أخرى.')),
      );
    }
  }

  Future<void> _saveAddedAttachment(String type, XFile attachment) async {
    final item = widget.item;
    showDialog<void>(
      context: context,
      barrierDismissible: false,
      builder: (_) => const Center(child: CircularProgressIndicator()),
    );
    try {
      final details = Map<String, String>.of(item.details)
        ..[_addedAttachmentTypeKey] = type
        ..[_addedAttachmentNameKey] = attachment.name;
      final updated = await widget.repository.update(
        PersonalEntryRecord(
          id: item.id,
          category: item.category,
          entryType: item.entryType ?? '',
          title: item.title,
          amount: item.totalAmount,
          dueDate: item.dueDate,
          status: item.status,
          details: details,
          attachmentUrl: item.attachmentPath,
        ),
        attachment: attachment,
      );
      if (!mounted) return;
      Navigator.of(context, rootNavigator: true).pop();
      setState(() {
        item.details = updated.details;
        item.attachmentPath = updated.attachmentUrl;
        item.lastUpdate = 'الآن';
        _detailSectionIndex = 2;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('تمت إضافة $type إلى الالتزام بنجاح')),
      );
    } catch (_) {
      if (!mounted) return;
      Navigator.of(context, rootNavigator: true).pop();
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('تعذر رفع المرفق. حاول مرة أخرى.')),
      );
    }
  }

  void _openSubscriptionPaymentForm() {
    final formKey = GlobalKey<FormState>();
    final payerController = TextEditingController();
    final amountController = TextEditingController();
    final dateController = TextEditingController();
    XFile? invoiceImage;

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setModalState) {
            return SafeArea(
              top: false,
              child: Container(
                constraints: BoxConstraints(
                  maxHeight: MediaQuery.of(context).size.height * 0.88,
                ),
                padding: EdgeInsets.fromLTRB(
                  16,
                  12,
                  16,
                  MediaQuery.of(context).viewInsets.bottom + 16,
                ),
                decoration: const BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
                ),
                child: Directionality(
                  textDirection: TextDirection.rtl,
                  child: Form(
                    key: formKey,
                    child: SingleChildScrollView(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          Center(
                            child: Container(
                              width: 44,
                              height: 5,
                              decoration: BoxDecoration(
                                color: const Color(0xFFE2E8F0),
                                borderRadius: BorderRadius.circular(99),
                              ),
                            ),
                          ),
                          const SizedBox(height: 16),
                          Row(
                            children: [
                              Container(
                                width: 46,
                                height: 46,
                                decoration: BoxDecoration(
                                  color: const Color(
                                    0xFF0EA5E9,
                                  ).withOpacity(0.12),
                                  borderRadius: BorderRadius.circular(13),
                                ),
                                child: const Icon(
                                  Icons.add_card_rounded,
                                  color: Color(0xFF0EA5E9),
                                ),
                              ),
                              const SizedBox(width: 10),
                              Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    const Text(
                                      'إضافة دفعة للاشتراك',
                                      style: TextStyle(
                                        fontSize: 19,
                                        fontWeight: FontWeight.w800,
                                        color: Color(0xFF0F172A),
                                      ),
                                    ),
                                    Text(
                                      'المتبقي ${widget.item.amount} درهم',
                                      style: const TextStyle(
                                        fontSize: 12,
                                        color: Color(0xFF64748B),
                                        fontWeight: FontWeight.w600,
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                              IconButton(
                                onPressed: () => Navigator.pop(context),
                                icon: const Icon(Icons.close_rounded),
                              ),
                            ],
                          ),
                          const SizedBox(height: 18),
                          TextFormField(
                            controller: payerController,
                            textInputAction: TextInputAction.next,
                            decoration: _paymentInputDecoration(
                              'اسم الشخص الذي دفع',
                              Icons.person_outline_rounded,
                            ),
                            validator: (value) =>
                                value == null || value.trim().isEmpty
                                ? 'أدخل اسم الشخص الذي دفع'
                                : null,
                          ),
                          const SizedBox(height: 12),
                          TextFormField(
                            controller: amountController,
                            keyboardType: const TextInputType.numberWithOptions(
                              decimal: true,
                            ),
                            textInputAction: TextInputAction.next,
                            decoration: _paymentInputDecoration(
                              'مبلغ الدفعة',
                              Icons.payments_outlined,
                              suffixText: 'درهم',
                            ),
                            validator: (value) {
                              final amount = double.tryParse(
                                value?.trim() ?? '',
                              );
                              if (amount == null || amount <= 0) {
                                return 'أدخل مبلغ دفعة صحيحاً';
                              }
                              if (amount > widget.item.amount) {
                                return 'المبلغ أكبر من المتبقي';
                              }
                              return null;
                            },
                          ),
                          const SizedBox(height: 12),
                          TextFormField(
                            controller: dateController,
                            readOnly: true,
                            decoration: _paymentInputDecoration(
                              'تاريخ الدفع',
                              Icons.event_outlined,
                            ),
                            onTap: () async {
                              final date = await showDatePicker(
                                context: context,
                                initialDate: DateTime.now(),
                                firstDate: DateTime(2020),
                                lastDate: DateTime.now(),
                              );
                              if (date != null) {
                                dateController.text =
                                    '${date.day}/${date.month}/${date.year}';
                              }
                            },
                            validator: (value) => value == null || value.isEmpty
                                ? 'حدد تاريخ الدفع'
                                : null,
                          ),
                          const SizedBox(height: 12),
                          InkWell(
                            onTap: () async {
                              final image = await ImagePicker().pickImage(
                                source: ImageSource.gallery,
                                imageQuality: 82,
                              );
                              if (image != null) {
                                setModalState(() => invoiceImage = image);
                              }
                            },
                            borderRadius: BorderRadius.circular(13),
                            child: Container(
                              padding: const EdgeInsets.all(14),
                              decoration: BoxDecoration(
                                color: const Color(0xFFF8FAFC),
                                borderRadius: BorderRadius.circular(13),
                                border: Border.all(
                                  color: invoiceImage == null
                                      ? const Color(0xFFE2E8F0)
                                      : const Color(0xFF0EA5E9),
                                ),
                              ),
                              child: Row(
                                children: [
                                  Icon(
                                    invoiceImage == null
                                        ? Icons.add_photo_alternate_outlined
                                        : Icons.check_circle_rounded,
                                    color: const Color(0xFF0EA5E9),
                                  ),
                                  const SizedBox(width: 10),
                                  Expanded(
                                    child: Text(
                                      invoiceImage?.name ??
                                          'إضافة صورة من الفاتورة',
                                      maxLines: 1,
                                      overflow: TextOverflow.ellipsis,
                                      style: const TextStyle(
                                        fontWeight: FontWeight.w700,
                                        color: Color(0xFF334155),
                                      ),
                                    ),
                                  ),
                                  const Icon(
                                    Icons.chevron_left_rounded,
                                    color: Color(0xFF94A3B8),
                                  ),
                                ],
                              ),
                            ),
                          ),
                          const SizedBox(height: 20),
                          SizedBox(
                            height: 50,
                            child: ElevatedButton.icon(
                              onPressed: () {
                                if (!(formKey.currentState?.validate() ??
                                    false)) {
                                  return;
                                }
                                if (invoiceImage == null) {
                                  ScaffoldMessenger.of(context).showSnackBar(
                                    const SnackBar(
                                      content: Text(
                                        'يرجى إضافة صورة من الفاتورة',
                                      ),
                                    ),
                                  );
                                  return;
                                }
                                final paymentAmount = double.parse(
                                  amountController.text.trim(),
                                ).round();
                                setState(() {
                                  widget.item.paidAmount += paymentAmount;
                                  widget.item.progress =
                                      (widget.item.paidAmount /
                                              widget.item.totalAmount)
                                          .clamp(0.0, 1.0);
                                  widget.item.lastUpdate = dateController.text;
                                  widget.item.payments.insert(
                                    0,
                                    _SubscriptionPayment(
                                      payerName: payerController.text.trim(),
                                      amount: paymentAmount,
                                      date: dateController.text,
                                      invoiceImagePath: invoiceImage?.path,
                                    ),
                                  );
                                });
                                Navigator.pop(context);
                                ScaffoldMessenger.of(this.context).showSnackBar(
                                  const SnackBar(
                                    content: Text('تم حفظ الدفعة وخصمها بنجاح'),
                                  ),
                                );
                              },
                              icon: const Icon(Icons.save_outlined),
                              label: const Text(
                                'حفظ الدفعة',
                                style: TextStyle(fontWeight: FontWeight.w800),
                              ),
                              style: ElevatedButton.styleFrom(
                                backgroundColor: const Color(0xFF0EA5E9),
                                foregroundColor: Colors.white,
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(13),
                                ),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            );
          },
        );
      },
    ).whenComplete(() async {
      await Future<void>.delayed(const Duration(milliseconds: 350));
      payerController.dispose();
      amountController.dispose();
      dateController.dispose();
    });
  }

  InputDecoration _paymentInputDecoration(
    String label,
    IconData icon, {
    String? suffixText,
  }) {
    return InputDecoration(
      labelText: label,
      prefixIcon: Icon(icon, color: const Color(0xFF0EA5E9)),
      suffixText: suffixText,
      filled: true,
      fillColor: const Color(0xFFF8FAFC),
      border: OutlineInputBorder(borderRadius: BorderRadius.circular(13)),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(13),
        borderSide: const BorderSide(color: Color(0xFFE2E8F0)),
      ),
      focusedBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(13),
        borderSide: const BorderSide(color: Color(0xFF0EA5E9), width: 1.5),
      ),
    );
  }

  Future<void> _openEditForm() async {
    final item = widget.item;
    final formKey = GlobalKey<FormState>();
    final titleController = TextEditingController(text: item.title);
    final amountController = TextEditingController(
      text: item.totalAmount.toString(),
    );
    final dueDateController = TextEditingController(text: item.dueDate);
    final detailControllers = <String, TextEditingController>{
      for (final entry in item.details.entries)
        if (!const {
          _addedAttachmentTypeKey,
          _addedAttachmentNameKey,
        }.contains(entry.key))
          entry.key: TextEditingController(text: entry.value),
    };
    var selectedStatus = item.status;
    var isSaving = false;

    await showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) => StatefulBuilder(
        builder: (sheetContext, setModalState) => SafeArea(
          top: false,
          child: Container(
            constraints: BoxConstraints(
              maxHeight: MediaQuery.of(sheetContext).size.height * 0.92,
            ),
            padding: EdgeInsets.fromLTRB(
              16,
              12,
              16,
              MediaQuery.of(sheetContext).viewInsets.bottom + 18,
            ),
            decoration: const BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.vertical(top: Radius.circular(22)),
            ),
            child: Directionality(
              textDirection: TextDirection.rtl,
              child: Form(
                key: formKey,
                child: SingleChildScrollView(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Center(
                        child: Container(
                          width: 42,
                          height: 4,
                          decoration: BoxDecoration(
                            color: const Color(0xFFCBD5E1),
                            borderRadius: BorderRadius.circular(99),
                          ),
                        ),
                      ),
                      const SizedBox(height: 18),
                      Row(
                        children: [
                          Container(
                            width: 46,
                            height: 46,
                            decoration: BoxDecoration(
                              color: item.iconBackground,
                              borderRadius: BorderRadius.circular(12),
                            ),
                            child: Icon(item.icon, color: item.iconColor),
                          ),
                          const SizedBox(width: 10),
                          const Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'تعديل الالتزام',
                                  style: TextStyle(
                                    fontSize: 19,
                                    fontWeight: FontWeight.w900,
                                    color: Color(0xFF0F172A),
                                  ),
                                ),
                                Text(
                                  'حدّث البيانات ثم احفظ التغييرات',
                                  style: TextStyle(
                                    fontSize: 12,
                                    color: Color(0xFF64748B),
                                  ),
                                ),
                              ],
                            ),
                          ),
                          IconButton(
                            tooltip: 'إغلاق',
                            onPressed: () => Navigator.pop(sheetContext),
                            icon: const Icon(Icons.close_rounded),
                          ),
                        ],
                      ),
                      const SizedBox(height: 18),
                      TextFormField(
                        controller: titleController,
                        decoration: _editInputDecoration(
                          'اسم الالتزام',
                          Icons.title_rounded,
                        ),
                        validator: (value) =>
                            value == null || value.trim().isEmpty
                            ? 'يرجى إدخال اسم الالتزام'
                            : null,
                      ),
                      const SizedBox(height: 12),
                      TextFormField(
                        controller: amountController,
                        keyboardType: const TextInputType.numberWithOptions(
                          decimal: true,
                        ),
                        decoration: _editInputDecoration(
                          'المبلغ',
                          Icons.payments_outlined,
                          suffixText: 'درهم',
                        ),
                        validator: (value) {
                          final amount = double.tryParse(value?.trim() ?? '');
                          return amount == null || amount < 0
                              ? 'أدخل مبلغاً صحيحاً'
                              : null;
                        },
                      ),
                      const SizedBox(height: 12),
                      TextFormField(
                        controller: dueDateController,
                        readOnly: true,
                        decoration: _editInputDecoration(
                          'تاريخ الاستحقاق',
                          Icons.event_outlined,
                        ),
                        onTap: () async {
                          final now = DateTime.now();
                          final date = await showDatePicker(
                            context: sheetContext,
                            initialDate: now,
                            firstDate: DateTime(now.year - 20),
                            lastDate: DateTime(now.year + 20),
                          );
                          if (date != null) {
                            dueDateController.text =
                                '${date.day}/${date.month}/${date.year}';
                          }
                        },
                      ),
                      const SizedBox(height: 12),
                      DropdownButtonFormField<String>(
                        initialValue: selectedStatus,
                        decoration: _editInputDecoration(
                          'الحالة',
                          Icons.flag_outlined,
                        ),
                        items:
                            const [
                                  'نشطة',
                                  'قريبة الاستحقاق',
                                  'متأخرة',
                                  'مكتملة',
                                ]
                                .map(
                                  (status) => DropdownMenuItem(
                                    value: status,
                                    child: Text(status),
                                  ),
                                )
                                .toList(growable: false),
                        onChanged: (value) {
                          if (value != null) selectedStatus = value;
                        },
                      ),
                      if (detailControllers.isNotEmpty) ...[
                        const SizedBox(height: 20),
                        const Text(
                          'بيانات الالتزام',
                          style: TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.w900,
                            color: Color(0xFF1E293B),
                          ),
                        ),
                        const SizedBox(height: 10),
                        for (final entry in detailControllers.entries) ...[
                          TextFormField(
                            controller: entry.value,
                            obscureText: _isSensitiveDetail(entry.key),
                            minLines: entry.key.contains('ملاحظ') ? 3 : 1,
                            maxLines: entry.key.contains('ملاحظ') ? 4 : 1,
                            decoration: _editInputDecoration(
                              entry.key,
                              Icons.edit_note_rounded,
                            ),
                          ),
                          const SizedBox(height: 12),
                        ],
                      ],
                      const SizedBox(height: 8),
                      ElevatedButton.icon(
                        onPressed: isSaving
                            ? null
                            : () async {
                                if (!(formKey.currentState?.validate() ??
                                    false)) {
                                  return;
                                }
                                setModalState(() => isSaving = true);
                                try {
                                  final updated = await widget.repository.update(
                                    PersonalEntryRecord(
                                      id: item.id,
                                      category: item.category,
                                      entryType: item.entryType ?? '',
                                      title: titleController.text.trim(),
                                      amount: double.parse(
                                        amountController.text.trim(),
                                      ).round(),
                                      dueDate: dueDateController.text.trim(),
                                      status: selectedStatus,
                                      details: {
                                        for (final entry
                                            in detailControllers.entries)
                                          if (entry.value.text
                                              .trim()
                                              .isNotEmpty)
                                            entry.key: entry.value.text.trim(),
                                        if (item.details[_addedAttachmentTypeKey] !=
                                            null)
                                          _addedAttachmentTypeKey: item
                                              .details[_addedAttachmentTypeKey]!,
                                        if (item.details[_addedAttachmentNameKey] !=
                                            null)
                                          _addedAttachmentNameKey: item
                                              .details[_addedAttachmentNameKey]!,
                                      },
                                      attachmentUrl: item.attachmentPath,
                                    ),
                                  );
                                  if (!mounted) return;
                                  setState(() {
                                    item.title = updated.title;
                                    item.totalAmount = updated.amount;
                                    item.dueDate = updated.dueDate;
                                    item.status = updated.status;
                                    item.statusColor = _personalStatusColor(
                                      updated.status,
                                    );
                                    item.details = updated.details;
                                    item.lastUpdate = 'الآن';
                                  });
                                  if (sheetContext.mounted) {
                                    Navigator.pop(sheetContext);
                                  }
                                  ScaffoldMessenger.of(context).showSnackBar(
                                    const SnackBar(
                                      content: Text('تم تحديث الالتزام بنجاح'),
                                    ),
                                  );
                                } catch (_) {
                                  if (sheetContext.mounted) {
                                    ScaffoldMessenger.of(
                                      sheetContext,
                                    ).showSnackBar(
                                      const SnackBar(
                                        content: Text(
                                          'تعذر تحديث الالتزام. حاول مرة أخرى.',
                                        ),
                                      ),
                                    );
                                  }
                                } finally {
                                  if (sheetContext.mounted) {
                                    setModalState(() => isSaving = false);
                                  }
                                }
                              },
                        icon: isSaving
                            ? const SizedBox.square(
                                dimension: 18,
                                child: CircularProgressIndicator(
                                  strokeWidth: 2,
                                  color: Colors.white,
                                ),
                              )
                            : const Icon(Icons.save_outlined),
                        label: Text(
                          isSaving ? 'جارٍ حفظ التغييرات...' : 'حفظ التغييرات',
                          style: const TextStyle(fontWeight: FontWeight.w900),
                        ),
                        style: ElevatedButton.styleFrom(
                          minimumSize: const Size.fromHeight(52),
                          backgroundColor: const Color(0xFF2563EB),
                          foregroundColor: Colors.white,
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(12),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    );

    await Future<void>.delayed(const Duration(milliseconds: 350));
    titleController.dispose();
    amountController.dispose();
    dueDateController.dispose();
    for (final controller in detailControllers.values) {
      controller.dispose();
    }
  }

  InputDecoration _editInputDecoration(
    String label,
    IconData icon, {
    String? suffixText,
  }) {
    return InputDecoration(
      labelText: label,
      prefixIcon: Icon(icon, color: const Color(0xFF2563EB)),
      suffixText: suffixText,
      filled: true,
      fillColor: const Color(0xFFF8FAFC),
      border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: Color(0xFFE2E8F0)),
      ),
      focusedBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(12),
        borderSide: const BorderSide(color: Color(0xFF2563EB), width: 1.5),
      ),
    );
  }

  bool _isSensitiveDetail(String label) {
    return label.contains('كلمة المرور') ||
        label.contains('رقم الحساب') ||
        label.contains('الآيبان');
  }

  @override
  Widget build(BuildContext context) => _buildUnifiedDetails(context);

  Widget _buildUnifiedDetails(BuildContext context) {
    final item = widget.item;
    final color = _pageColor;

    return Scaffold(
      backgroundColor: const Color(0xFFF5F7FA),
      floatingActionButtonLocation: FloatingActionButtonLocation.endFloat,
      floatingActionButton: FloatingActionButton(
        key: const ValueKey('add-commitment-attachment'),
        tooltip: 'إضافة فاتورة أو مستند',
        onPressed: _openAddAttachmentMenu,
        backgroundColor: const Color(0xFFE5B22E),
        foregroundColor: const Color(0xFF3D2E08),
        elevation: 5,
        shape: const CircleBorder(),
        child: const Icon(Icons.add_rounded, size: 29),
      ),
      appBar: AppBar(
        toolbarHeight: 60,
        backgroundColor: Colors.white,
        surfaceTintColor: Colors.transparent,
        foregroundColor: const Color(0xFF172033),
        elevation: 0,
        scrolledUnderElevation: 1,
        centerTitle: true,
        title: Text(
          'تفاصيل ${item.entryType ?? 'الالتزام'}',
          style: const TextStyle(
            fontSize: 18,
            fontWeight: FontWeight.w900,
            color: Color(0xFF172033),
          ),
        ),
        leading: IconButton(
          tooltip: 'رجوع',
          onPressed: () => Navigator.pop(context),
          icon: const Icon(Icons.arrow_back_ios_new_rounded, size: 20),
        ),
      ),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: ListView(
          key: const ValueKey('compact-personal-details'),
          padding: const EdgeInsets.fromLTRB(14, 14, 14, 92),
          children: [
            _CompactCommitmentHeader(
              item: item,
              color: color,
              remainingDays: _remainingDaysLabel(item.dueDate),
              onAction: _handleMenuAction,
            ),
            const SizedBox(height: 12),
            _InlineDetailsTabs(
              sections: _detailSections,
              selectedIndex: _detailSectionIndex,
              color: color,
              onSelected: (index) =>
                  setState(() => _detailSectionIndex = index),
            ),
            const SizedBox(height: 12),
            AnimatedSwitcher(
              duration: const Duration(milliseconds: 180),
              child: KeyedSubtree(
                key: ValueKey(_detailSectionIndex),
                child: _buildSelectedSection(item, color),
              ),
            ),
          ],
        ),
      ),
    );
  }

  String _remainingDaysLabel(String value) {
    final parts = value.split('/');
    if (parts.length != 3) return '';
    final day = int.tryParse(parts[0]);
    final month = int.tryParse(parts[1]);
    final year = int.tryParse(parts[2]);
    if (day == null || month == null || year == null) return '';
    final days = DateTime(
      year,
      month,
      day,
    ).difference(DateUtils.dateOnly(DateTime.now())).inDays;
    if (days == 0) return 'اليوم';
    if (days < 0) return 'متأخر ${days.abs()} يوم';
    return 'بعد $days يوم';
  }

  Widget _buildSelectedSection(_CommitmentItem item, Color color) {
    return switch (_detailSectionIndex) {
      1 => _HistoryDetailsCard(item: item, color: color),
      2 => _DocumentsDetailsCard(item: item, color: color),
      3 => _FollowupDetailsCard(item: item, color: color),
      _ => _SummaryDetailsCard(
        item: item,
        color: color,
        expanded: _showAllDetails,
        isSensitive: _isSensitiveDetail,
        onToggleExpanded: () =>
            setState(() => _showAllDetails = !_showAllDetails),
      ),
    };
  }

