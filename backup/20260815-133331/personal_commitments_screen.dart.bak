class _DetailsSectionContent extends StatelessWidget {
  final int index;
  final _CommitmentItem item;

  const _DetailsSectionContent({required this.index, required this.item});

  @override
  Widget build(BuildContext context) {
    if (item.details.isNotEmpty && index == 0) {
      return Column(
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          if (item.entryType != null)
            _detailLine('نوع الإدخال', item.entryType!),
          ...item.details.entries.map(
            (entry) => _detailLine(
              entry.key,
              _isSensitiveDetail(entry.key) ? '••••••••' : entry.value,
            ),
          ),
          if (item.attachmentPath != null)
            _detailLine('المرفق', 'تم إرفاق مستند'),
        ],
      );
    }

    if (item.isSubscription && index == 0) {
      return Column(
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          _detailLine('اسم الاشتراك', item.title),
          _detailLine('عدد الأفراد', '${item.subscriptionMembers}'),
          _detailLine('مبلغ الفاتورة الكلي', '${item.totalAmount} درهم'),
          _detailLine('إجمالي المدفوع', '${item.paidAmount} درهم'),
          _detailLine('المبلغ المتبقي', '${item.amount} درهم'),
          _detailLine('آخر موعد للسداد', item.dueDate),
        ],
      );
    }

    if (item.isSubscription && index == 1) {
      if (item.payments.isEmpty) {
        return const Text(
          'لم تتم إضافة دفعات حتى الآن',
          style: TextStyle(
            fontSize: 12,
            color: Color(0xFF64748B),
            fontWeight: FontWeight.w600,
          ),
        );
      }
      return Column(
        children: item.payments
            .map(
              (payment) => Container(
                width: double.infinity,
                margin: const EdgeInsets.only(bottom: 7),
                padding: const EdgeInsets.all(10),
                decoration: BoxDecoration(
                  color: const Color(0xFFF8FAFC),
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: const Color(0xFFE2E8F0)),
                ),
                child: Row(
                  children: [
                    Icon(
                      payment.invoiceImagePath == null
                          ? Icons.receipt_long_outlined
                          : Icons.image_outlined,
                      color: const Color(0xFF0EA5E9),
                    ),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            payment.payerName,
                            style: const TextStyle(
                              fontWeight: FontWeight.w800,
                              color: Color(0xFF0F172A),
                            ),
                          ),
                          Text(
                            payment.date,
                            style: const TextStyle(
                              fontSize: 11,
                              color: Color(0xFF64748B),
                            ),
                          ),
                        ],
                      ),
                    ),
                    Text(
                      '${payment.amount} درهم',
                      style: const TextStyle(
                        fontWeight: FontWeight.w900,
                        color: Color(0xFF059669),
                      ),
                    ),
                  ],
                ),
              ),
            )
            .toList(),
      );
    }

    final List<List<String>> entries = [
      [
        'اسم الالتزام: ${item.title}',
        'الحالة: ${item.status}',
        'المبلغ: ${item.amount} درهم',
        'تاريخ الاستحقاق القادم: ${item.dueDate}',
        'عدد الدفعات المتبقية: ${item.remainingInstallments}',
        'نسبة الإنجاز: ${(item.progress * 100).toInt()}%',
        'آخر دفعة: 150 درهم',
        'تنبيه الاستحقاق: مفعّل',
      ],
      [
        'سجل جميع الدفعات',
        'دفعات جديدة / مستقبلية / متأخرة',
        'إجمالي المدفوع: 300 درهم',
        'إجمالي المتبقي: 450 درهم',
        'إيصالات الدفع',
        'طرق الدفع المستخدمة',
      ],
      [
        'العقود',
        'الفواتير',
        'الإيصالات',
        'الضمانات',
        'الصور',
        'ملفات PDF',
        'مستندات التجديد',
      ],
      ['مهام قادمة', 'مهام متأخرة', 'مهام مكتملة', 'تذكيرات', 'ملاحظات تنفيذ'],
    ];

    final rows = entries[index];

    return Column(
      crossAxisAlignment: CrossAxisAlignment.end,
      children: rows
          .map(
            (e) => Padding(
              padding: const EdgeInsets.only(bottom: 4),
              child: Text(
                e,
                style: const TextStyle(
                  fontSize: 11,
                  color: Color(0xFF334155),
                  fontWeight: FontWeight.w600,
                ),
              ),
            ),
          )
          .toList(growable: false),
    );
  }

  bool _isSensitiveDetail(String label) {
    return label.contains('كلمة المرور') ||
        label.contains('رقم الحساب') ||
        label.contains('الآيبان');
  }

  Widget _detailLine(String label, String value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 6),
      child: Text(
        '$label: $value',
        textDirection: TextDirection.rtl,
        style: const TextStyle(
          fontSize: 12,
          color: Color(0xFF334155),
          fontWeight: FontWeight.w700,
        ),
      ),
    );
  }
}

class _SubscriptionAmountTile extends StatelessWidget {
