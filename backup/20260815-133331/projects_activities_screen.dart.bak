class _AssetHero extends StatelessWidget {
  const _AssetHero({
    required this.item,
    required this.baseColor,
    required this.gradientEnd,
    required this.categoryLabel,
  });

  final _AssetItem item;
  final Color baseColor;
  final Color gradientEnd;
  final String categoryLabel;

  @override
  Widget build(BuildContext context) {
    final progress =
        ((item.contractProgress +
                    item.paymentProgress +
                    item.documentsProgress) /
                3)
            .clamp(0.0, 1.0);
    final progressText = '${(progress * 100).toStringAsFixed(0)}%';

    return Container(
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topRight,
          end: Alignment.bottomLeft,
          colors: [baseColor, gradientEnd],
        ),
      ),
      padding: const EdgeInsets.fromLTRB(20, 74, 20, 16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.end,
        mainAxisAlignment: MainAxisAlignment.end,
        children: [
          Row(
            children: [
              Container(
                width: 46,
                height: 46,
                decoration: BoxDecoration(
                  color: Colors.white.withValues(alpha: 0.16),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(
                    color: Colors.white.withValues(alpha: 0.24),
                  ),
                ),
                child: Icon(
                  _assetIcon(item.category),
                  color: Colors.white,
                  size: 22,
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      item.title,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 18,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      '$categoryLabel • ${item.subType}',
                      style: TextStyle(
                        color: Colors.white.withValues(alpha: 0.85),
                        fontSize: 11,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ],
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 10,
                  vertical: 5,
                ),
                decoration: BoxDecoration(
                  color: Colors.white.withValues(alpha: 0.18),
                  borderRadius: BorderRadius.circular(99),
                ),
                child: Text(
                  item.status,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 11,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              Expanded(
                child: ClipRRect(
                  borderRadius: BorderRadius.circular(99),
                  child: LinearProgressIndicator(
                    value: progress,
                    minHeight: 6,
                    backgroundColor: Colors.white.withValues(alpha: 0.22),
                    valueColor: const AlwaysStoppedAnimation<Color>(
                      Colors.white,
                    ),
                  ),
                ),
              ),
              const SizedBox(width: 10),
              Text(
                'التقدم $progressText',
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 11,
                  fontWeight: FontWeight.w700,
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            '${item.locationOrType}  •  ${item.amountLabel}',
            style: TextStyle(
              color: Colors.white.withValues(alpha: 0.9),
              fontSize: 11,
              fontWeight: FontWeight.w700,
            ),
          ),
        ],
      ),
    );
  }

  IconData _assetIcon(String category) {
    if (category == 'real_estate') return Icons.apartment_rounded;
    if (category == 'project') return Icons.account_tree_rounded;
    return Icons.storefront_rounded;
  }
}

class _EntryGroupCard extends StatelessWidget {
  const _EntryGroupCard({
    required this.group,
    required this.entries,
    required this.onAdd,
    required this.onEdit,
    required this.onDelete,
  });

  final _ActionGroup group;
  final List<Map<String, String>> entries;
  final VoidCallback onAdd;
  final ValueChanged<int> onEdit;
  final ValueChanged<int> onDelete;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFFE2E8F0)),
        boxShadow: [
          BoxShadow(
            color: const Color(0xFF0F172A).withValues(alpha: 0.04),
            blurRadius: 8,
            offset: const Offset(0, 3),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Row(
            children: [
              Container(
                width: 34,
                height: 34,
                decoration: BoxDecoration(
                  color: group.color.withValues(alpha: 0.12),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Icon(group.icon, color: group.color, size: 18),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  group.title,
                  style: const TextStyle(
                    fontSize: 14,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF0F172A),
                  ),
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                decoration: BoxDecoration(
                  color: group.color.withValues(alpha: 0.10),
                  borderRadius: BorderRadius.circular(99),
                ),
                child: Text(
                  '${entries.length}',
                  style: TextStyle(
                    color: group.color,
                    fontSize: 11,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ),
              const SizedBox(width: 6),
              InkWell(
                borderRadius: BorderRadius.circular(10),
                onTap: onAdd,
                child: Container(
                  padding: const EdgeInsets.all(6),
                  decoration: BoxDecoration(
                    color: group.color,
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: const Icon(
                    Icons.add_rounded,
                    size: 18,
                    color: Colors.white,
                  ),
                ),
              ),
            ],
          ),
          if (entries.isEmpty) ...[
            const SizedBox(height: 10),
            Text(
              'لا توجد ${group.title} بعد — اضغط + للإضافة',
              textAlign: TextAlign.right,
              style: const TextStyle(
                fontSize: 11,
                color: Color(0xFF94A3B8),
                fontWeight: FontWeight.w600,
              ),
            ),
          ] else ...[
            const SizedBox(height: 10),
            for (var i = 0; i < entries.length; i++) ...[
              _EntryTile(
                entry: entries[i],
                color: group.color,
                primaryLabel: group.fields.first.label,
                secondaryLabels: group.fields
                    .skip(1)
                    .map((f) => f.label)
                    .toList(growable: false),
                onEdit: () => onEdit(i),
                onDelete: () => onDelete(i),
              ),
              if (i < entries.length - 1)
                Divider(
                  height: 14,
                  thickness: 0.6,
                  color: const Color(0xFFE2E8F0).withValues(alpha: 0.8),
                ),
            ],
          ],
        ],
      ),
    );
  }
}

class _EntryTile extends StatelessWidget {
  const _EntryTile({
    required this.entry,
    required this.color,
    required this.primaryLabel,
    required this.secondaryLabels,
    required this.onEdit,
    required this.onDelete,
  });

  final Map<String, String> entry;
  final Color color;
  final String primaryLabel;
  final List<String> secondaryLabels;
  final VoidCallback onEdit;
  final VoidCallback onDelete;

  @override
  Widget build(BuildContext context) {
    final title = (entry[primaryLabel] ?? '').isNotEmpty
        ? entry[primaryLabel]!
        : 'بدون عنوان';
    final subtitle = secondaryLabels
        .map((label) => entry[label] ?? '')
        .where((v) => v.trim().isNotEmpty)
        .take(3)
        .join(' • ');

    return InkWell(
      onTap: onEdit,
      borderRadius: BorderRadius.circular(10),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 4),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Container(
              width: 8,
              height: 8,
              margin: const EdgeInsets.only(top: 6),
              decoration: BoxDecoration(
                color: color,
                borderRadius: BorderRadius.circular(3),
              ),
            ),
            const SizedBox(width: 8),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    title,
                    style: const TextStyle(
                      fontSize: 12.5,
                      fontWeight: FontWeight.w800,
                      color: Color(0xFF0F172A),
                    ),
                  ),
                  if (subtitle.isNotEmpty) ...[
                    const SizedBox(height: 2),
                    Text(
                      subtitle,
                      style: const TextStyle(
                        fontSize: 10.5,
                        color: Color(0xFF64748B),
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ],
                ],
              ),
            ),
            IconButton(
              onPressed: onEdit,
              icon: Icon(Icons.edit_outlined, size: 18, color: color),
              padding: EdgeInsets.zero,
              constraints: const BoxConstraints(minWidth: 32, minHeight: 32),
              tooltip: 'تعديل',
            ),
            IconButton(
              onPressed: onDelete,
              icon: const Icon(
                Icons.delete_outline_rounded,
                size: 18,
                color: Color(0xFFDC2626),
              ),
              padding: EdgeInsets.zero,
              constraints: const BoxConstraints(minWidth: 32, minHeight: 32),
              tooltip: 'حذف',
            ),
          ],
        ),
      ),
    );
  }
}

class _ActionGroup {
  const _ActionGroup({
    required this.title,
    required this.kind,
    required this.color,
    required this.icon,
    required this.fields,
  });

  final String title;
  final String kind;
  final Color color;
  final IconData icon;
  final List<_FieldDef> fields;
}

class _FieldDef {
  const _FieldDef(
    this.label,
    this.isNumeric, {
    this.isDate = false,
    this.multiline = false,
  });

  final String label;
  final bool isNumeric;
  final bool isDate;
  final bool multiline;
}

class _AssetItem {
  _AssetItem({
    required this.title,
    required this.subType,
    required this.category,
    required this.locationOrType,
    required this.status,
    required this.amountLabel,
    required this.followupNote,
    required this.owner,
    required this.tenant,
    required this.rentValue,
    required this.endDate,
    required this.annualYield,
    required this.occupancyRate,
    required this.contractProgress,
    required this.paymentProgress,
    required this.documentsProgress,
    required this.needsAttention,
    required this.documents,
    required this.contracts,
    required this.tasks,
    required this.alerts,
    required this.logs,
    this.id,
    this.iconColor,
    List<Map<String, String>>? maintenance,
    List<Map<String, String>>? rentals,
    List<Map<String, String>>? expenses,
    List<Map<String, String>>? revenues,
  }) : maintenance = maintenance ?? <Map<String, String>>[],
       rentals = rentals ?? <Map<String, String>>[],
       expenses = expenses ?? <Map<String, String>>[],
       revenues = revenues ?? <Map<String, String>>[];

  final String? id;
  final String title;
  final String subType;
  final String category;
  final String locationOrType;
  final String status;
  final String amountLabel;
  final String followupNote;
  final String owner;
  final String tenant;
  final String rentValue;
  final String endDate;
  final String annualYield;
  final double occupancyRate;
  final double contractProgress;
  final double paymentProgress;
  final double documentsProgress;
  final bool needsAttention;
  final List<String> documents;
  final List<String> contracts;
  final List<String> tasks;
  final List<String> alerts;
  final List<String> logs;
  final Color? iconColor;
  final List<Map<String, String>> maintenance;
  final List<Map<String, String>> rentals;
  final List<Map<String, String>> expenses;
  final List<Map<String, String>> revenues;
}
