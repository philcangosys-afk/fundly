  Widget _buildFollowupLine(String label, int count) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 8),
      child: Row(
        textDirection: TextDirection.rtl,
        children: [
          Text(
            '$count',
            style: const TextStyle(
              fontSize: 12,
              fontWeight: FontWeight.w800,
              color: Color(0xFF0B4A73),
            ),
          ),
          const SizedBox(width: 8),
          Expanded(
            child: Text(
              label,
              textAlign: TextAlign.right,
              style: const TextStyle(
                fontSize: 12,
                color: Color(0xFF334155),
                fontWeight: FontWeight.w600,
              ),
            ),
          ),
        ],
      ),
    );
  }

  bool _matchesQuery(String value) {
    final query = _searchController.text.trim();
    return query.isEmpty || value.contains(query);
  }

  List<String> _filterItems(List<String> items) {
    if (_searchController.text.trim().isEmpty) return items;
    return items.where(_matchesQuery).toList(growable: false);
  }

  Color _categoryColor(String key) {
    switch (key) {
      case 'real_estate':
        return const Color(0xFF0F6AA8);
      case 'activity':
        return const Color(0xFF10B981);
      case 'equipment':
        return const Color(0xFFF59E0B);
      case 'other':
        return const Color(0xFF7C3AED);
      default:
        return const Color(0xFF0B4A73);
    }
  }

  Color get _pageColor => Color.lerp(
    widget.item.iconColor ?? _categoryColor(widget.item.category),
    const Color(0xFF073B67),
    0.35,
  )!;

  @override
  Widget build(BuildContext context) {
    final item = widget.item;
    final baseColor = _pageColor;
    const sections = [
      DetailSectionTab(label: 'الملخص', icon: Icons.bar_chart_rounded),
      DetailSectionTab(
        label: 'المتابعة',
        icon: Icons.notifications_none_rounded,
      ),
      DetailSectionTab(label: 'الإدخالات', icon: Icons.folder_copy_outlined),
      DetailSectionTab(label: 'السجل', icon: Icons.schedule_rounded),
    ];

    return Scaffold(
      backgroundColor: const Color(0xFFF5F7FA),
      floatingActionButtonLocation: FloatingActionButtonLocation.endFloat,
      floatingActionButton: FloatingActionButton(
        key: const ValueKey('add-asset-detail-entry'),
        tooltip: 'إضافة إدخال',
        onPressed: _openMainEntryTypesSheet,
        backgroundColor: const Color(0xFFE5B22E),
        foregroundColor: const Color(0xFF3D2E08),
        elevation: 5,
        shape: const CircleBorder(),
        child: const Icon(Icons.add_rounded, size: 29),
      ),
      appBar: AppBar(
        toolbarHeight: 60,
        backgroundColor: Colors.white,
        surfaceTintColor: Colors.transparent,
        foregroundColor: const Color(0xFF172033),
        elevation: 0,
        scrolledUnderElevation: 1,
        centerTitle: true,
        title: Text(
          'تفاصيل ${_categoryLabel(item.category)}',
          style: const TextStyle(
            fontSize: 18,
            fontWeight: FontWeight.w900,
            color: Color(0xFF172033),
          ),
        ),
        leading: IconButton(
          tooltip: 'رجوع',
          onPressed: () => Navigator.pop(context),
          icon: const Icon(Icons.arrow_back_ios_new_rounded, size: 20),
        ),
      ),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: ListView(
          key: const ValueKey('compact-asset-details'),
          padding: const EdgeInsets.fromLTRB(14, 14, 14, 92),
          children: [
            DetailPageHeader(
              title: item.title,
              subtitle: '${item.subType} · ${item.locationOrType}',
              icon: item.category == 'activity'
                  ? Icons.storefront_rounded
                  : Icons.apartment_rounded,
              color: baseColor,
              status: item.status,
              statusColor: item.needsAttention
                  ? const Color(0xFFF59E0B)
                  : const Color(0xFF10B981),
              metrics: [
                DetailHeaderMetric(
                  label: 'القيمة',
                  value: item.amountLabel,
                  icon: Icons.account_balance_wallet_outlined,
                ),
                DetailHeaderMetric(
                  label: 'تاريخ الانتهاء',
                  value: item.endDate,
                  icon: Icons.calendar_month_outlined,
                ),
                DetailHeaderMetric(
                  label: 'العائد',
                  value: item.annualYield,
                  icon: Icons.trending_up_rounded,
                ),
              ],
              trailing: IconButton(
                tooltip: 'اختيار الأقسام',
                onPressed: _openDetailSectionsSheet,
                icon: const Icon(
                  Icons.more_vert_rounded,
                  size: 23,
                  color: Color(0xFF475569),
                ),
              ),
            ),
            const SizedBox(height: 12),
            DetailPageTabs(
              sections: sections,
              selectedIndex: _selectedTab,
              color: baseColor,
              onSelected: (index) => setState(() => _selectedTab = index),
            ),
            const SizedBox(height: 12),
            if (_selectedTab == 0) ...[
              _ProgressOverviewCard(item: item),
              const SizedBox(height: 12),
              _SummaryCard(item: item),
            ] else if (_selectedTab == 1)
              _FollowupCard(onViewDetails: _openFollowupDetailsSheet)
            else if (_selectedTab == 2) ...[
              _SearchInput(
                controller: _searchController,
                hint: 'ابحث داخل الإدخالات',
                onFilterTap: _openDetailSectionsSheet,
                onChanged: (_) => setState(() {}),
              ),
              const SizedBox(height: 12),
              for (final group in _groups) ...[
                _EntryGroupCard(
                  group: group,
                  entries: _filterEntries(_entriesByKind[group.kind]!),
                  onAdd: () => _openActionForm(group),
                  onEdit: (index) => _openActionForm(
                    group,
                    existing: _entriesByKind[group.kind]![index],
                    editIndex: index,
                  ),
                  onDelete: (index) => _deleteEntry(group, index),
                ),
                const SizedBox(height: 10),
              ],
            ] else ...[
              const _AlertsKnowledgeCard(),
              const SizedBox(height: 10),
              _ActivityLogCard(logs: item.logs),
            ],
          ],
        ),
      ),
    );
  }

  List<Map<String, String>> _filterEntries(List<Map<String, String>> entries) {
    final query = _searchController.text.trim();
    if (query.isEmpty) return entries;
    return entries
        .where((e) => e.values.any((v) => v.contains(query)))
        .toList(growable: false);
  }

  String _categoryLabel(String key) {
    if (key == 'real_estate') return 'العقارات';
    if (key == 'activity') return 'الأنشطة';
    if (key == 'equipment') return 'المعدات';
    return 'أخرى';
  }
}

