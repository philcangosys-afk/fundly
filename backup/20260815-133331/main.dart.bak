  Widget _buildSecondaryTabView() {
    if (_selectedIndex == 1) {
      return const _ReportsHubPage();
    }
    if (_selectedIndex == 2) {
      return const _ArchiveHubPage();
    }
    return const _WalletsHubPage();
  }

  Widget _buildTopCategories() {
    const categories = [
      (
        'الالتزامات الشخصية',
        Icons.person_outline_rounded,
        Color(0xFF3B82F6),
        [
          ('ديون لك: 500 درهم', Icons.south_west_rounded, Color(0xFF07835C)),
          ('ديون عليك: 200 درهم', Icons.north_east_rounded, Color(0xFFC73E4D)),
          ('الالتزامات النشطة: 8', Icons.task_alt_rounded, Color(0xFF2563B8)),
        ],
      ),
      (
        'الالتزامات المشتركة',
        Icons.groups_2_outlined,
        Color(0xFF10B981),
        [
          ('التزامات مشتركة: 3', Icons.groups_rounded, Color(0xFF087F6A)),
          (
            'غير مفعلة: 2',
            Icons.pause_circle_outline_rounded,
            Color(0xFFB56A09),
          ),
        ],
      ),
      (
        'إدارة الأشخاص والجهات',
        Icons.people_alt_outlined,
        Color(0xFF7956A8),
        [
          (
            'مستند واحد قريب الانتهاء',
            Icons.warning_amber_rounded,
            Color(0xFFC05A15),
          ),
        ],
      ),
      (
        'العقارات/الأنشطة التجارية/المعدات وأخرى',
        Icons.apartment_rounded,
        Color(0xFFF59E0B),
        [
          (
            'مستند واحد قريب الانتهاء',
            Icons.event_busy_outlined,
            Color(0xFFC2415D),
          ),
        ],
      ),
    ];

    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16),
      child: GridView.builder(
        key: const ValueKey('home-categories-grid'),
        itemCount: categories.length,
        shrinkWrap: true,
        physics: const NeverScrollableScrollPhysics(),
        gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: _showCategoriesInTwoColumns ? 2 : 1,
          crossAxisSpacing: 12,
          mainAxisSpacing: 12,
          mainAxisExtent: _showCategoriesInTwoColumns ? 124 : 108,
        ),
        itemBuilder: (context, index) {
          final category = categories[index];
          return KeyedSubtree(
            key: _categoryKeys[index],
            child: _buildCategoryTileCompact(
              category.$1,
              category.$2,
              category.$3,
              category.$4,
              index,
              compact: _showCategoriesInTwoColumns,
            ),
          );
        },
      ),
    );
  }

  Widget _buildCategoryTileCompact(
    String title,
    IconData icon,
    Color color,
    List<(String, IconData, Color)> items,
    int categoryIndex, {
    required bool compact,
  }) {
    return AnimatedBuilder(
      animation: _categoryFlashAnimation,
      builder: (context, child) {
        final flash = _flashingCategoryIndex == categoryIndex
            ? _categoryFlashAnimation.value
            : 0.0;
        return Container(
          decoration: BoxDecoration(
            color: Color.lerp(
              Colors.white,
              color.withValues(alpha: 0.18),
              flash,
            ),
            borderRadius: BorderRadius.circular(14),
            boxShadow: [
              BoxShadow(
                color: color.withValues(alpha: 0.1 + (flash * 0.25)),
                blurRadius: 10 + (flash * 10),
                offset: Offset(0, 4),
              ),
            ],
            border: Border.all(
              color: Color.lerp(color.withValues(alpha: 0.14), color, flash)!,
              width: 1.2 + (flash * 1.8),
            ),
          ),
          child: Material(
            color: Colors.transparent,
            borderRadius: BorderRadius.circular(14),
            clipBehavior: Clip.antiAlias,
            child: InkWell(
              key: ValueKey('home-category-$categoryIndex'),
              onTap: () => _openPriorityScreen(title),
              borderRadius: BorderRadius.circular(14),
              child: Padding(
                padding: EdgeInsets.symmetric(
                  horizontal: compact ? 10 : 12,
                  vertical: 10,
                ),
                child: child,
              ),
            ),
          ),
        );
      },
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          Row(
            textDirection: TextDirection.rtl,
            children: [
              _HomeCategoryIcon(icon: icon, color: color),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  key: ValueKey('home-category-title-$categoryIndex'),
                  title,
                  maxLines: compact ? 2 : 1,
                  overflow: TextOverflow.ellipsis,
                  textAlign: TextAlign.right,
                  style: TextStyle(
                    fontSize: compact ? 11.5 : 13.5,
                    height: 1.2,
                    fontWeight: FontWeight.w900,
                    color: const Color(0xFF1F2937),
                  ),
                ),
              ),
              const SizedBox(width: 6),
              _HomeCategoryArrow(color: color),
            ],
          ),
          const SizedBox(height: 8),
          Expanded(
            child: compact
                ? ListView.separated(
                    scrollDirection: Axis.horizontal,
                    reverse: true,
                    itemCount: items.length,
                    separatorBuilder: (_, __) => const SizedBox(width: 6),
                    itemBuilder: (context, index) {
                      final item = items[index];
                      return SizedBox(
                        width: 116,
                        child: _HomeCategoryMetric(
                          label: item.$1,
                          icon: item.$2,
                          color: item.$3,
                          compact: true,
                        ),
                      );
                    },
                  )
                : Row(
                    textDirection: TextDirection.rtl,
                    children: [
                      for (var index = 0; index < items.length; index++) ...[
                        if (index > 0) const SizedBox(width: 7),
                        Expanded(
                          child: _HomeCategoryMetric(
                            label: items[index].$1,
                            icon: items[index].$2,
                            color: items[index].$3,
                            compact: false,
                          ),
                        ),
                      ],
                    ],
                  ),
          ),
        ],
      ),
    );
  }

  void _openPriorityScreen(String title) {
    if (title == 'الالتزامات الشخصية') {
      Navigator.of(context).push(
        MaterialPageRoute(builder: (_) => const PersonalCommitmentsScreen()),
      );
      return;
    }

    if (title == 'الالتزامات المشتركة') {
      Navigator.of(context).push(
        MaterialPageRoute(builder: (_) => const SharedCommitmentsScreen()),
      );
      return;
    }

    if (title == 'إدارة الأشخاص' || title == 'إدارة الأشخاص والجهات') {
      Navigator.of(
        context,
      ).push(MaterialPageRoute(builder: (_) => const PeopleManagementScreen()));
      return;
    }

    if (title == 'المشاريع' ||
        title == 'العقارات والمشاريع والأنشطة والمعدات' ||
        title == 'العقارات/الأنشطة التجارية/المعدات وأخرى') {
      Navigator.of(context).push(
        MaterialPageRoute(builder: (_) => const ProjectsActivitiesScreen()),
      );
      return;
    }

    return;
  }

  Widget _buildCategoryTile(
    String title,
    IconData icon,
    Color color,
    List<String> items,
    int categoryIndex,
  ) {
    final bool isPersonalCommitments = title == 'الالتزامات الشخصية';

    return AnimatedBuilder(
      animation: _categoryFlashAnimation,
      builder: (context, child) {
        final flash = _flashingCategoryIndex == categoryIndex
            ? _categoryFlashAnimation.value
            : 0.0;
        return Container(
          padding: EdgeInsets.all(20),
          decoration: BoxDecoration(
            color: Color.lerp(
              Colors.white,
              color.withValues(alpha: 0.18),
              flash,
            ),
            borderRadius: BorderRadius.circular(20),
            boxShadow: [
              BoxShadow(
                color: color.withValues(alpha: 0.12 + (flash * 0.25)),
                blurRadius: 16 + (flash * 10),
                offset: Offset(0, 8),
              ),
            ],
            border: Border.all(
              color: Color.lerp(color.withValues(alpha: 0.15), color, flash)!,
              width: 1.5 + (flash * 1.8),
            ),
          ),
          child: child,
        );
      },
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          Row(
            textDirection: TextDirection.rtl,
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Container(
                padding: EdgeInsets.all(12),
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    colors: [color.withOpacity(0.2), color.withOpacity(0.08)],
                  ),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(color: color.withOpacity(0.2), width: 1),
                ),
                child: Icon(icon, color: color, size: 26),
              ),
              Expanded(
                child: Text(
                  title,
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w800,
                    color: Colors.black87,
                    letterSpacing: 0.3,
                  ),
                  textAlign: TextAlign.right,
                ),
              ),
            ],
          ),
          SizedBox(height: 16),
          ...items.map(
            (item) => Padding(
              padding: EdgeInsets.only(bottom: 10),
              child: Row(
                textDirection: TextDirection.rtl,
                children: [
                  Container(
                    width: 6,
                    height: 6,
                    decoration: BoxDecoration(
                      gradient: LinearGradient(
                        colors: [color, color.withOpacity(0.6)],
                      ),
                      shape: BoxShape.circle,
                      boxShadow: [
                        BoxShadow(color: color.withOpacity(0.4), blurRadius: 4),
                      ],
                    ),
                  ),
                  SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      item,
                      style: TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.w500,
                        color: Colors.grey[700],
                        height: 1.4,
                      ),
                      textDirection: TextDirection.rtl,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                ],
              ),
            ),
          ),
          if (isPersonalCommitments) ...[
            SizedBox(height: 6),
            _buildPersonalCommitmentCards(color),
          ],
          SizedBox(height: 12),
          Align(
            alignment: Alignment.centerRight,
            child: GestureDetector(
              onTap: () => _openPriorityScreen(title),
              child: Container(
                padding: EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                decoration: BoxDecoration(
                  color: color.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: color.withOpacity(0.2), width: 1),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  textDirection: TextDirection.rtl,
                  children: [
                    Icon(Icons.arrow_forward, color: color, size: 16),
                    SizedBox(width: 6),
                    Text(
                      'عرض المزيد',
                      style: TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.w700,
                        color: color,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPersonalCommitmentCards(Color color) {
    return Row(
      textDirection: TextDirection.rtl,
      children: [
        Expanded(
          child: Container(
            padding: EdgeInsets.symmetric(horizontal: 12, vertical: 10),
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [Color(0xFFFEE2E2), Color(0xFFFFF1F2)],
                begin: Alignment.topRight,
                end: Alignment.bottomLeft,
              ),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: Color(0xFFFB7185).withOpacity(0.3),
                width: 1,
              ),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Row(
                  textDirection: TextDirection.rtl,
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Icon(Icons.south_east, color: Color(0xFFFB7185), size: 16),
                    Text(
                      'عليك',
                      style: TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w700,
                        color: Color(0xFF9F1239),
                      ),
                    ),
                  ],
                ),
                SizedBox(height: 8),
                _buildCurrencyAmount('2,000', Color(0xFFBE123C)),
              ],
            ),
          ),
        ),
        SizedBox(width: 10),
        Expanded(
          child: Container(
            padding: EdgeInsets.symmetric(horizontal: 12, vertical: 10),
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [Color(0xFFDCFCE7), Color(0xFFF0FDF4)],
                begin: Alignment.topRight,
                end: Alignment.bottomLeft,
              ),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: Color(0xFF10B981).withOpacity(0.35),
                width: 1,
              ),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Row(
                  textDirection: TextDirection.rtl,
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Icon(Icons.north_west, color: Color(0xFF10B981), size: 16),
                    Text(
                      'لك',
                      style: TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w700,
                        color: Color(0xFF047857),
                      ),
                    ),
                  ],
                ),
                SizedBox(height: 8),
                _buildCurrencyAmount('2,500', Color(0xFF047857)),
              ],
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildCurrencyAmount(String amount, Color amountColor) {
    return RichText(
      textDirection: TextDirection.rtl,
      text: TextSpan(
        children: [
          TextSpan(
            text: amount,
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.w800,
              color: amountColor,
            ),
          ),
          WidgetSpan(child: SizedBox(width: 4)),
          TextSpan(
            text: 'درهم',
            style: TextStyle(
              fontSize: 10,
              fontWeight: FontWeight.w600,
              color: amountColor.withOpacity(0.9),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBottomNavigation() {
    return SafeArea(
      top: false,
      child: Padding(
        padding: const EdgeInsets.fromLTRB(12, 0, 12, 8),
        child: Directionality(
          textDirection: TextDirection.rtl,
          child: Row(
            children: [
              Expanded(
                child: _buildGlassNavItem(
                  index: 0,
                  label: 'الرئيسية',
                  icon: Icons.home_outlined,
                  selectedIcon: Icons.home_rounded,
                ),
              ),
              Expanded(
                child: _buildGlassNavItem(
                  index: 1,
                  label: 'التقارير',
                  icon: Icons.analytics_outlined,
                  selectedIcon: Icons.analytics_rounded,
                ),
              ),
              Expanded(
                child: _buildGlassNavItem(
                  index: 2,
                  label: 'الأرشيف',
                  icon: Icons.archive_outlined,
                  selectedIcon: Icons.archive_rounded,
                ),
              ),
              Expanded(
                child: _buildGlassNavItem(
                  index: 3,
                  label: 'المحافظ',
                  icon: Icons.account_balance_wallet_outlined,
                  selectedIcon: Icons.account_balance_wallet_rounded,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildGlassNavItem({
    required int index,
    required String label,
    required IconData icon,
    required IconData selectedIcon,
  }) {
    final isSelected = _selectedIndex == index;
    return InkWell(
      onTap: () => setState(() => _selectedIndex = index),
      borderRadius: BorderRadius.circular(18),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 2),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            _buildGlassNavIcon(isSelected ? selectedIcon : icon, isSelected),
            const SizedBox(height: 8),
            Text(
              label,
              style: TextStyle(
                fontSize: 12,
                fontWeight: isSelected ? FontWeight.w800 : FontWeight.w600,
                color: isSelected
                    ? const Color(0xFF0F4D86)
                    : const Color(0xFF64748B),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildGlassNavIcon(IconData icon, bool selected) {
    return AnimatedContainer(
      duration: const Duration(milliseconds: 220),
      curve: Curves.easeOutCubic,
      width: 44,
      height: 44,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(15),
        gradient: LinearGradient(
          colors: selected
              ? const [Color(0xFF2E4F7D), Color(0xFF192F4B)]
              : const [Color(0xFF2A3E58), Color(0xFF182536)],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        border: Border.all(
          color: selected ? const Color(0xFF9BE8FF) : const Color(0xFF6B87A7),
          width: selected ? 1.4 : 1,
        ),
        boxShadow: [
          BoxShadow(
            color: selected ? const Color(0x6600E5FF) : const Color(0x332F9BFF),
            blurRadius: selected ? 14 : 8,
            offset: const Offset(0, 3),
          ),
          const BoxShadow(
            color: Color(0x1AFFFFFF),
            blurRadius: 1,
            offset: Offset(0, -1),
          ),
        ],
      ),
      child: Icon(
        icon,
        size: 24,
        color: selected ? const Color(0xFFA7F3FF) : const Color(0xFF93C5FD),
      ),
    );
  }
}

class _HomeHeaderAction extends StatelessWidget {
  const _HomeHeaderAction({
    required this.tooltip,
    required this.icon,
    required this.onTap,
    this.backgroundColor = const Color(0xD1FFFFFF),
    this.iconColor = const Color(0xFF0F6AA8),
    this.borderColor = const Color(0xFFCCE5F4),
    this.showBadge = false,
  });

  final String tooltip;
  final IconData icon;
  final VoidCallback onTap;
  final Color backgroundColor;
  final Color iconColor;
  final Color borderColor;
  final bool showBadge;

  @override
  Widget build(BuildContext context) {
    return Stack(
      clipBehavior: Clip.none,
      children: [
        Tooltip(
          message: tooltip,
          child: Material(
            color: backgroundColor,
            borderRadius: BorderRadius.circular(11),
            child: InkWell(
              onTap: onTap,
              borderRadius: BorderRadius.circular(11),
              child: SizedBox(
                width: 40,
                height: 40,
                child: DecoratedBox(
                  decoration: BoxDecoration(
                    border: Border.all(color: borderColor),
                    borderRadius: BorderRadius.circular(11),
                  ),
                  child: Icon(icon, color: iconColor, size: 21),
                ),
              ),
            ),
          ),
        ),
        if (showBadge)
          Positioned(
            top: 7,
            right: 8,
            child: Container(
              width: 7,
              height: 7,
              decoration: const BoxDecoration(
                color: Color(0xFFE5484D),
                shape: BoxShape.circle,
              ),
            ),
          ),
      ],
    );
  }
}

class _HomeSummaryItem extends StatelessWidget {
  const _HomeSummaryItem({
    super.key,
    required this.title,
    required this.detail,
    required this.icon,
    required this.color,
    required this.selected,
    required this.onTap,
  });

  final String title;
  final String detail;
  final IconData icon;
  final Color color;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Material(
      color: selected ? color.withValues(alpha: 0.11) : const Color(0xFFF8FAFC),
      borderRadius: BorderRadius.circular(10),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(10),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 180),
          padding: const EdgeInsets.all(10),
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(10),
            border: Border.all(
              color: selected
                  ? color.withValues(alpha: 0.55)
                  : const Color(0xFFE4EAF0),
              width: selected ? 1.4 : 1,
            ),
          ),
          child: Row(
            textDirection: TextDirection.rtl,
            children: [
              Container(
                width: 38,
                height: 38,
                decoration: BoxDecoration(
                  color: color.withValues(alpha: 0.11),
                  borderRadius: BorderRadius.circular(9),
                ),
                child: Icon(icon, color: color, size: 20),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      title,
                      style: const TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.w900,
                        color: Color(0xFF1F2937),
                      ),
                    ),
                    const SizedBox(height: 3),
                    Text(
                      detail,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontSize: 10.5,
                        height: 1.3,
                        fontWeight: FontWeight.w600,
                        color: Color(0xFF64748B),
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 7),
              Icon(
                selected
                    ? Icons.check_circle_rounded
                    : Icons.radio_button_unchecked_rounded,
                color: selected ? color : const Color(0xFFB6C1CD),
                size: 20,
              ),
            ],
          ),
        ),
      ),
    );
  }
}

