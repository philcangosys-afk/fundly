      ),
      child: Material(
        color: Colors.transparent,
        borderRadius: BorderRadius.circular(14),
        child: InkWell(
          key: const ValueKey('home-global-summary-toggle'),
          onTap: _openGlobalSummarySheet,
          borderRadius: BorderRadius.circular(14),
          child: SizedBox(
            height: 82,
            child: Stack(
              alignment: Alignment.center,
              children: [
                PositionedDirectional(
                  start: 14,
                  child: Container(
                    width: 42,
